[access]
	inheritFrom = All-Projects
[submit]
	action = rebase if necessary
[access "refs/*"]
	owner = group user/Stefan Nuxoll (snuxoll)
[access "refs/for/refs/*"]
	push = group user/Stefan Nuxoll (snuxoll)
	read = group user/Stefan Nuxoll (snuxoll)
	rebase = group user/Stefan Nuxoll (snuxoll)
	removeReviewer = group user/Stefan Nuxoll (snuxoll)
	submit = group user/Stefan Nuxoll (snuxoll)
[access "refs/heads/*"]
	create = group user/Stefan Nuxoll (snuxoll)
	push = group user/Stefan Nuxoll (snuxoll)
	label-Code-Review = -2..+2 group user/GoValkyrieBot
	label-Code-Review = -2..+2 group user/Stefan Nuxoll (snuxoll)
	label-Verified = -1..+1 group user/Stefan Nuxoll (snuxoll)
	label-Verified = -1..+1 group vali-scheme CI
	pushMerge = group user/Stefan Nuxoll (snuxoll)
	read = group user/Stefan Nuxoll (snuxoll)
[access "refs/tags/*"]
	push = group user/Stefan Nuxoll (snuxoll)
	push = +force group user/Stefan Nuxoll (snuxoll)
[label "Code-Review"]
	value = -2 Do not submit
	value = -1 I would prefer that you didn't submit this
	value = 0 No score
	value = +1 Looks good to me, but someone else must approve
	value = +2 Looks good to me, approved
	defaultValue = 0
	copyCondition = changekind:NO_CHANGE OR changekind:TRIVIAL_REBASE OR changekind:NO_CODE_CHANGE OR is:MIN OR is:"-1"
	function = NoBlock
[label "Verified"]
	value = -1 Fails
	value = 0 No score
	value = +1 Verified
	defaultValue = 0
	copyCondition = changekind:NO_CODE_CHANGE OR changekind:NO_CHANGE
	function = NoBlock

[submit-requirement "Verified"]
	description = CI must pass
	applicableIf = -branch:refs/meta/config
	submittableIf = label:Verified=MAX AND -label:Verified=MIN
	canOverrideInChildProjects = false
[submit-requirement "Code-Review"]
	description = A +2 is needed, and a -2 blocks
	submittableIf = label:Code-Review=MAX AND -label:Code-Review=MIN
	canOverrideInChildProjects = false
