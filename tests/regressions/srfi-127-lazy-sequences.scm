;;; requirement: (srfi 127) lazy sequences
;;; found-in: SRFI audit
;;; kind: scheme

;; The SRFI's own tests (by John Cowan), ported to SRFI 64, and more for
;; laziness, sharing and the ends of finite lseqs.

(import (scheme base) (scheme char) (scheme cxr) (srfi 64) (srfi 127))

(test-begin "srfi-127")
(test-assert (memq 'srfi-127 (features)))


;; Make-generator for tests cloned from SRFI 121
(define (make-generator . args)
        (lambda () (if (null? args)
                       (eof-object)
                       (let ((next (car args)))
                            (set! args (cdr args))
                            next))))

;; Make-lseq creates an lseq, like list, but guarantees the use of a generator
(define (make-lseq . args) (generator->lseq (apply make-generator args)))



(test-group "lseqs"
  (test-group "lseqs/constructor"
    (define one23 (make-lseq 1 2 3))
    (test-equal 1 (car one23))
    (test-assert (procedure? (cdr one23)))
    (test-equal '(1 2 3) (lseq-realize one23))
  )
  (test-group "lseqs/predicates"
    (test-assert (lseq? '()))
    (test-assert (lseq? '(1 2 3)))
    (test-assert (lseq? (make-lseq 1 2 3)))
    (test-assert (lseq? (cons 'x (lambda () 'x))))

    (test-assert (lseq=? = '() '()))
    (test-assert (lseq=? = '(1 2 3) '(1 2 3)))
    (test-assert (lseq=? = (make-lseq 1 2 3)
                           (make-lseq 1 2 3)))
    (test-assert (lseq=? = (make-lseq 1 2 3) '(1 2 3)))
  )
  (test-group "lseqs/selectors"
    (test-error (lseq-car (make-generator)))
    (test-equal 1 (lseq-car (make-lseq 1 2 3)))
    (test-equal 1 (lseq-car '(1 2 3)))
    (test-error (lseq-car 2))

    (test-error (lseq-first (make-generator)))
    (test-equal 1 (lseq-first (make-lseq 1 2 3)))
    (test-equal 1 (lseq-first '(1 2 3)))
    (test-error (lseq-first 2))

    (test-error (lseq-cdr (make-generator)))
    (test-equal 2 (lseq-cdr '(1 . 2)))
    (test-equal 2 (lseq-car (lseq-cdr '(1 2 3))))
    (test-equal 2 (lseq-car (lseq-cdr (make-lseq 1 2 3))))

    (test-error (lseq-rest (make-generator)))
    (test-equal 2 (lseq-rest '(1 . 2)))
    (test-equal 2 (lseq-car (lseq-rest '(1 2 3))))
    (test-equal 2 (lseq-car (lseq-rest (make-lseq 1 2 3))))
    (test-error (lseq-rest 2))

    (test-error (lseq-ref '() 0))
    (test-equal 1 (lseq-ref '(1) 0))
    (test-equal 2 (lseq-ref '(1 2) 1))
    (test-error (lseq-ref (make-lseq) 0))
    (test-equal 1 (lseq-ref (make-lseq 1) 0))
    (test-equal 1 (lseq-ref (make-lseq 1 2) 0))
    (test-equal 2 (lseq-ref (make-lseq 1 2) 1))

    (test-error (lseq-take '() 1))
    (test-error (lseq-take (make-lseq) 1))
    (test-assert (procedure? (cdr (lseq-take '(1 2 3 4 5) 3)))) ; test laziness
    (test-equal '(1 2 3) (lseq-realize (lseq-take '(1 2 3 4 5) 3)))

    (test-error (lseq-drop '() 1))
    (test-error (lseq-drop (make-lseq 1) 2))
    (test-equal '(3 4 5) (lseq-realize (lseq-drop '(1 2 3 4 5) 2)))
    (test-equal '(3 4 5) (lseq-realize (lseq-drop (make-lseq 1 2 3 4 5) 2)))
  )
  (test-group "lseqs/whole"
  (define g #f)
  (define one23abc #f)
  (define one2345 #f)
  (define oddeven #f)
  (test-equal '() (lseq-realize '()))
  (test-equal '(1 2 3) (lseq-realize '(1 2 3)))
  (test-equal '() (lseq-realize (make-lseq)))
  (test-equal '(1 2 3) (lseq-realize (make-lseq 1 2 3)))
  (set! g (lseq->generator '(1 2 3)))
  (begin
      (test-equal 1 (g))
      (test-equal 2 (g))
      (test-equal 3 (g))
      (test-assert (eof-object? (g))))
  (set! g (lseq->generator (make-lseq 1 2 3)))
  (begin
      (test-equal 1 (g))
      (test-equal 2 (g))
      (test-equal 3 (g))
      (test-assert (eof-object? (g))))
  (test-equal 0 (lseq-length '()))
  (test-equal 3 (lseq-length '(1 2 3)))
  (test-equal 3 (lseq-length (make-lseq 1 2 3)))
  (test-equal '(1 2 3 a b c) (lseq-realize (lseq-append '(1 2 3) '(a b c))))
  (set! one23abc (lseq-append (make-lseq 1 2 3) (make-lseq 'a 'b 'c)))
  (test-assert (procedure? (cdr one23abc)))
  (test-assert (lseq-realize one23abc))
  (set! one2345 (make-lseq 1 2 3 4 5))
  (set! oddeven (make-lseq 'odd 'even 'odd 'even 'odd 'even 'odd 'even))
  (test-equal '((one 1 odd) (two 2 even) (three 3 odd))
          (lseq-realize (lseq-zip '(one two three) one2345 oddeven))))
  (test-group "lseqs/mapping"
  (define output #f)
  (define out! #f)
  (define odds #f)
  (test-equal '() (lseq-map - '()))
  (test-equal '(-1 -2 -3) (lseq-realize (lseq-map - '(1 2 3))))
  (test-equal '(-1 -2 -3) (lseq-realize (lseq-map - (make-lseq 1 2 3))))
  (test-assert (procedure? (cdr (lseq-map - '(1 2 3)))))
  (set! output '())
  (set! out! (lambda (x) (set! output (cons x output))))
  (lseq-for-each out! '())
  (test-equal output '())
  (lseq-for-each out! '(a b c))
  (test-equal output '(c b a))
  (lseq-for-each out! (make-lseq 1 2 3))
  (test-equal output '(3 2 1 c b a))
  (test-equal '() (lseq-filter odd? '()))
  (set! odds (lseq-filter odd? '(1 2 3 4 5)))
  (test-assert (procedure? (cdr odds)))
  (test-equal '(1 3 5) (lseq-realize odds))
  (test-equal '(1 3 5) (lseq-realize (lseq-filter odd? (make-lseq 1 2 3 4 5))))
  (test-equal '() (lseq-remove even? '()))
  (set! odds (lseq-remove even? '(1 2 3 4 5)))
  (test-assert (procedure? (cdr odds)))
  (test-equal '(1 3 5) (lseq-realize odds))
  (test-equal '(1 3 5) (lseq-realize (lseq-remove even? (make-lseq 1 2 3 4 5)))))
  (test-group "lseqs/searching"
  (define factorial #f)
  (test-equal 4 (lseq-find even? '(3 1 4 1 5 9 2 6)))
  (test-equal 4 (lseq-find even? (make-lseq 3 1 4 1 5 9 2 6)))
  (test-equal #f (lseq-find negative? (make-lseq 1 2 3 4 5)))
  (test-equal '(-8 -5 0 0) (lseq-realize (lseq-find-tail even? '(3 1 37 -8 -5 0 0))))
  (test-equal '(-8 -5 0 0) (lseq-realize (lseq-find-tail even?
                                                     (make-lseq 3 1 37 -8 -5 0 0))))
  (test-equal #f (lseq-find-tail even? '()))
  (test-equal #f (lseq-find-tail negative? (make-lseq 1 2 3 4 5)))
  (test-equal '(2 18) (lseq-realize (lseq-take-while even? '(2 18 3 10 22 9))))
  (test-equal '(2 18) (lseq-realize (lseq-take-while even?
                                                 (make-lseq 2 18 3 10 22 9))))
  (test-equal '(2 18) (lseq-realize (lseq-take-while even?
                                                 (make-lseq 2 18 3 10 22 9))))
  (test-equal '(3 10 22 9) (lseq-drop-while even? '(2 18 3 10 22 9)))
  (test-equal '(3 10 22 9) (lseq-realize (lseq-drop-while even?
                                       (make-lseq 2 18 3 10 22 9))))
  (test-equal #t (lseq-any integer? '(a 3 b 2.7)))
  (test-equal #t (lseq-any integer? (make-lseq 'a 3 'b 2.7)))
  (test-equal #f (lseq-any integer? '(a 3.1 b 2.7)))
  (test-equal #f (lseq-any integer? (make-lseq 'a 3.1 'b 2.7)))
  (test-equal #t (lseq-any < '(3 1 4 1 5) '(2 7 1 8 2)))
  (set! factorial (lambda (n) (cond
        ((< n 0) #f)
        ((= n 0) 1)
        (else (* n (factorial (- n 1)))))))
  (test-equal 6 (lseq-any factorial '(-1 -2 3 4)))
  (test-equal 6 (lseq-any factorial (make-lseq -1 -2 3 4)))
  (test-equal 24 (lseq-every factorial '(1 2 3 4)))
  (test-equal 24 (lseq-every factorial (make-lseq 1 2 3 4)))
  (test-equal 2 (lseq-index even? '(3 1 4 1 5 9)))
  (test-equal 1 (lseq-index < '(3 1 4 1 5 9 2 5 6) '(2 7 1 8 2)))
  (test-equal #f (lseq-index = '(3 1 4 1 5 9 2 5 6) '(2 7 1 8 2)))
  (test-equal '(a b c) (lseq-realize (lseq-memq 'a '(a b c))))
  (test-equal '(a b c) (lseq-realize (lseq-memq 'a (make-lseq 'a 'b 'c))))
  (test-equal #f (lseq-memq 'a (make-lseq 'b 'c 'd)))
  (test-equal #f (lseq-memq (list 'a) '(b c d)))
  (test-equal #f (lseq-memq (list 'a) (make-lseq 'b 'c 'd)))
  (test-equal '(101 102) (lseq-realize (lseq-memv 101 (make-lseq 100 101 102))))
  (test-equal '((a) c) (lseq-realize (lseq-member (list 'a) (make-lseq 'b '(a) 'c))))
  (test-equal '(2 3) (lseq-realize (lseq-member 2.0 (make-lseq 1 2 3) =))))) ; end lseqs

(test-group "more"
  (define (naturals-from n)
    (lambda () (let ((v n)) (set! n (+ n 1)) v)))
  (define nat (generator->lseq (naturals-from 1)))
  (define count 0)
  (define counting
    (generator->lseq (lambda () (set! count (+ count 1)) count)))
  (define partly #f)
  (define done #f)
  (test-equal 1 count)
  (test-equal 3 (lseq-ref counting 2))
  (test-equal 3 count)
  (test-equal 3 (lseq-ref counting 2))
  (test-equal 3 count)
  (test-equal '(1 2 3) (lseq-realize (lseq-take nat 3)))
  (test-equal '(4 5) (lseq-realize (lseq-take (lseq-drop nat 3) 2)))
  (test-equal '(1 4 9 16 25)
    (lseq-realize (lseq-take (lseq-map (lambda (n) (* n n)) nat) 5)))
  (test-equal '(2 4 6)
    (lseq-realize (lseq-take (lseq-filter even? nat) 3)))
  (test-equal '(1 3 5)
    (lseq-realize (lseq-take (lseq-remove even? nat) 3)))
  (test-equal '((one 1) (two 2))
    (lseq-realize (lseq-zip '(one two) nat)))
  (test-equal '((1) (2) (3)) (lseq-realize (lseq-zip '(1 2 3))))
  (test-equal '(5 7 9) (lseq-realize (lseq-map + '(1 2 3) '(4 5 6))))
  (test-equal '(5 7) (lseq-realize (lseq-map + '(1 2) '(4 5 6))))
  (test-equal '(1 2 3 4 5 6)
    (lseq-realize (lseq-append '(1 2 3) (make-lseq 4 5) '(6))))
  (test-equal '() (lseq-realize (lseq-append)))
  (test-equal '(1 2 3) (lseq-realize (lseq-take-while (lambda (n) (< n 4)) nat)))
  (test-equal '() (lseq-realize (lseq-take-while even? '())))
  (test-equal '() (lseq-realize (lseq-take-while even? '(1 2))))
  (test-equal '(2 4) (lseq-realize (lseq-take-while even? '(2 4))))
  (test-equal '() (lseq-drop-while even? '(2 4)))
  (test-equal 6 (lseq-car (lseq-drop-while (lambda (n) (< n 6)) nat)))
  (test-equal 7 (lseq-find (lambda (n) (> n 6)) nat))
  (test-equal #t (lseq-any (lambda (n) (> n 6)) nat))
  (test-equal #f (lseq-every (lambda (n) (< n 6)) nat))
  (test-equal 3 (lseq-index (lambda (n) (= n 4)) nat))
  (test-equal '(5 6) (lseq-realize (lseq-take (lseq-member 5 nat) 2)))
  (test-equal '(2 3) (lseq-realize (lseq-take (lseq-memv 2 nat) 2)))
  (test-equal '() (lseq-realize (lseq-take nat 0)))
  (test-equal 0 (lseq-length (make-lseq)))
  (test-assert (lseq=? = nat nat))
  (test-assert (not (lseq=? = '(1 2) '(1 2 3))))
  (test-assert (not (lseq=? = '(1 2 3) '(1 2))))
  (test-assert (not (lseq=? = '(1 2 3) '(1 2 4))))
  (test-assert (lseq=? (lambda (a b) (= a (+ b 1))) '(2 3) '(1 2)))
  (test-assert (not (lseq? 5)))
  (test-assert (not (lseq? '(1 2 . 3))))
  (test-assert (not (lseq? '(1 2 . #f))))
  (test-equal #t (lseq-every even? '()))
  (test-equal #f (lseq-any even? '()))
  (set! partly (make-lseq 1 2 3 4))
  (lseq-cdr partly)
  (test-equal '(1 2 3 4) (let ((g (lseq->generator partly)))
                            (let loop ((acc '()))
                              (let ((v (g)))
                                (if (eof-object? v) (reverse acc) (loop (cons v acc)))))))
  (set! done (make-lseq 1 2))
  (lseq-realize done)
  (test-equal '(1 2) done)
  (test-assert (list? done)))

(test-group "reads no further than asked"
  ;; A source that counts the elements it has been asked for.
  (define (counting-source)
    (let ((n 0))
      (cons (lambda () (set! n (+ n 1)) n)
            (lambda () n))))
  (define (make src) (generator->lseq (car src)))
  ;; take
  (let ((src (counting-source)))
    (let ((l (lseq-take (make src) 3)))
      (test-equal '(1 2 3) (lseq-realize l))
      (test-equal 3 ((cdr src)))))
  ;; take of a filtered infinite source: three matches, no more.
  (let ((src (counting-source)))
    (let ((l (lseq-take (lseq-filter even? (make src)) 3)))
      (test-equal '(2 4 6) (lseq-realize l))
      (test-equal 6 ((cdr src)))))
  ;; ->generator, map and take-while
  (let ((src (counting-source)))
    (let ((g (lseq->generator (make src))))
      (g)
      (g)
      (test-equal 2 ((cdr src)))))
  (let ((src (counting-source)))
    (let ((l (lseq-map (lambda (x) (* x x)) (make src))))
      (test-equal 1 (lseq-car l))
      (test-equal 1 ((cdr src)))
      (lseq-cdr l)
      (test-equal 2 ((cdr src)))))
  (let ((src (counting-source)))
    (let ((l (lseq-take-while (lambda (x) (< x 3)) (make src))))
      (test-equal '(1 2) (lseq-realize l))
      (test-equal 3 ((cdr src)))))
  ;; Reading characters from a port: no character past the last one used.
  (let* ((port (open-input-string "abcdef"))
         (l (lseq-take (generator->lseq (lambda () (read-char port))) 2)))
    (test-equal '(#\a #\b) (lseq-realize l))
    (test-equal #\c (read-char port)))
  (let* ((port (open-input-string "a1b2c3"))
         (l (lseq-filter char-alphabetic? (generator->lseq (lambda () (read-char port))))))
    (test-equal #\a (lseq-car l))
    (test-equal #\1 (read-char port)))
  ;; Finite sources still end properly.
  (test-equal '(2 4) (lseq-realize (lseq-filter even? '(1 2 3 4 5))))
  (test-equal '(1 2) (lseq-realize (lseq-take '(1 2 3) 2)))
  (test-equal '(1 4) (lseq-realize (lseq-map + '(1 2) '(0 2))))
  (test-equal '(1 2) (lseq-realize (lseq-take-while (lambda (x) (< x 3)) '(1 2 3 4)))))

(test-group "lseq? on circular lists"
  (let ((c (list 1 2 3)))
    (set-cdr! (cddr c) c)
    (test-assert (not (lseq? c))))
  (let ((c (list 1)))
    (set-cdr! c c)
    (test-assert (not (lseq? c))))
  (let ((c (list 1 2 3 4)))
    (set-cdr! (cdddr c) (cdr c))
    (test-assert (not (lseq? c))))
  (test-assert (lseq? '(1 2 3 4 5 6 7 8 9)))
  (test-assert (lseq? (cons 1 (cons 2 (lambda () 3))))))

(test-end "srfi-127")
