;;; requirement: (srfi 143) fixnum operations are available, with Vali's 61-bit fixnums, and signal an error where the SRFI's fixnum rule is broken
;;; found-in: SRFI audit
;;; kind: scheme

(import (scheme base) (srfi 64) (srfi 143))

(test-begin "srfi-143")

(define-syntax values->list
  (syntax-rules ()
    ((_ e) (call-with-values (lambda () e) list))))

;; Constants: Vali's fixnums are 61 bits, and these are the fixnum range.
(test-equal 61 fx-width)
(test-equal (- (expt 2 60) 1) fx-greatest)
(test-equal (- (expt 2 60)) fx-least)
(test-assert (fixnum? fx-greatest))
(test-assert (fixnum? fx-least))
(test-assert (not (fixnum? (+ fx-greatest 1))))
(test-assert (not (fixnum? (- fx-least 1))))
(test-assert (>= fx-width 24))

;; Predicates.
(test-assert (fixnum? 0))
(test-assert (fixnum? -17))
(test-assert (not (fixnum? 1.0)))
(test-assert (not (fixnum? 1/2)))
(test-assert (not (fixnum? 'a)))
(test-assert (not (fixnum? (expt 2 100))))
(test-assert (fx=? 1 1 1))
(test-assert (not (fx=? 1 1 2)))
(test-assert (fx<? 1 2 3))
(test-assert (not (fx<? 1 3 3)))
(test-assert (fx>? 3 2 1))
(test-assert (fx<=? 1 1 2))
(test-assert (fx>=? 2 2 1))
(test-assert (fx<? fx-least fx-greatest))
(test-assert (fxzero? 0))
(test-assert (not (fxzero? 1)))
(test-assert (fxpositive? 3))
(test-assert (fxnegative? -3))
(test-assert (not (fxnegative? 0)))
(test-assert (fxodd? -3))
(test-assert (fxeven? 0))
(test-assert (fxeven? fx-least))
(test-assert (fxodd? fx-greatest))
(test-equal 5 (fxmax 3 5 1))
(test-equal 1 (fxmin 3 5 1))

;; Arithmetic.
(test-equal 5 (fx+ 2 3))
(test-equal -1 (fx- 2 3))
(test-equal -3 (fxneg 3))
(test-equal 6 (fx* 2 3))
(test-equal 3 (fxquotient 7 2))
(test-equal -3 (fxquotient -7 2))
(test-equal 1 (fxremainder 7 2))
(test-equal -1 (fxremainder -7 2))
(test-equal 5 (fxabs -5))
(test-equal 25 (fxsquare -5))
(test-equal '(4 1) (values->list (fxsqrt 17)))
(test-equal '(0 0) (values->list (fxsqrt 0)))
(test-equal fx-greatest (fx+ (- fx-greatest 1) 1))
(test-equal fx-least (fx- (+ fx-least 1) 1))
(test-equal fx-least (fx+ fx-least 0))
(test-equal fx-greatest (fx- 0 (+ fx-least 1)))

;; The fixnum rule: an error, never a wrong fixnum or a bignum.
(test-error (fx+ fx-greatest 1))
(test-error (fx- fx-least 1))
(test-error (fx* fx-greatest 2))
(test-error (fx* fx-least -1))
(test-error (fxneg fx-least))
(test-error (fxabs fx-least))
(test-error (fxsquare (expt 2 31)))
(test-error (fxquotient fx-least -1))
(test-error (fxquotient 1 0))
(test-error (fxremainder 1 0))
(test-error (fxsqrt -1))
(test-error (fx+ 1.5 1))
(test-error (fx+ 1 (expt 2 100)))
(test-error (fx+ 'a 1))
(test-error (fxzero? 0.0))
(test-error (fx<? 1 2 'c))
(test-error (fxmax 1 2.0))
(test-error (fxnot (expt 2 70)))
(test-error (fxand 1 1.0))

;; Arithmetic with carry. The results are (values remainder quotient) of
;; balanced division by 2^fx-width.
(test-equal (list fx-least 1) (values->list (fx+/carry fx-greatest 1 0)))
(test-equal '(5 0) (values->list (fx+/carry 2 2 1)))
(test-equal (list fx-greatest -1) (values->list (fx+/carry fx-least fx-least fx-greatest)))
(test-equal (list fx-greatest -1) (values->list (fx-/carry fx-least 1 0)))
(test-equal '(-3 0) (values->list (fx-/carry 2 2 3)))
(test-equal '(-2 1) (values->list (fx*/carry fx-greatest 2 0)))
(test-equal '(7 0) (values->list (fx*/carry 2 3 1)))
(test-equal (list 0 (expt 2 59)) (values->list (fx*/carry fx-least fx-least 0)))
(let-values (((r q) (fx*/carry fx-greatest fx-greatest fx-greatest)))
  (test-equal (+ (* fx-greatest fx-greatest) fx-greatest)
              (+ r (* q (expt 2 61))))
  (test-assert (and (fixnum? r) (fixnum? q))))

;; Bitwise operations.
(test-equal -11 (fxnot 10))
(test-equal 36 (fxnot -37))
(test-equal fx-least (fxnot fx-greatest))
(test-equal 10 (fxand 11 26))
(test-equal 11 (fxior 3 10))
(test-equal 9 (fxxor 3 10))
(test-equal -1 (fxand))
(test-equal 0 (fxior))
(test-equal 0 (fxxor))
(test-equal 1 (fxand 7 3 9))
(test-equal 9 (fxif 3 1 8))
(test-equal #b00110011 (fxif #b00111100 #b11110000 #b00001111))
(test-equal 32 (fxarithmetic-shift 8 2))
(test-equal 4 (fxarithmetic-shift 8 -1))
(test-equal -3 (fxarithmetic-shift -5 -1))
(test-equal -1 (fxarithmetic-shift -1 -60))
(test-equal 0 (fxarithmetic-shift 1 -60))
(test-equal fx-least (fxarithmetic-shift -1 60))
(test-equal 32 (fxarithmetic-shift-left 8 2))
(test-equal 2 (fxarithmetic-shift-right 8 2))
(test-equal -2 (fxarithmetic-shift-right -8 2))
(test-error (fxarithmetic-shift 1 61))
(test-error (fxarithmetic-shift 1 -61))
(test-error (fxarithmetic-shift 1 60))
(test-error (fxarithmetic-shift fx-greatest 1))
(test-error (fxarithmetic-shift-left 1 -1))
(test-error (fxarithmetic-shift-right 1 -1))
(test-error (fxarithmetic-shift-left 1 61))
(test-equal 3 (fxbit-count 7))
(test-equal 2 (fxbit-count -13))
(test-equal 0 (fxbit-count -1))
(test-equal 60 (fxbit-count fx-greatest))
(test-equal 60 (fxbit-count fx-least))
(test-equal 0 (fxlength 0))
(test-equal 3 (fxlength 7))
(test-equal 3 (fxlength -8))
(test-equal 60 (fxlength fx-greatest))
(test-equal 60 (fxlength fx-least))
(test-equal #t (fxbit-set? 3 10))
(test-equal #f (fxbit-set? 1 1))
(test-equal #t (fxbit-set? 60 -1))
(test-equal #f (fxbit-set? 60 1))
(test-error (fxbit-set? 61 1))
(test-error (fxbit-set? -1 1))
(test-equal #b100 (fxcopy-bit 2 0 #t))
(test-equal #b1011 (fxcopy-bit 2 #b1111 #f))
(test-error (fxcopy-bit 60 -1 #f))
(test-equal fx-least (fxcopy-bit 60 fx-least #t))
(test-error (fxcopy-bit 60 0 #t))
(test-error (fxcopy-bit 61 0 #t))
(test-equal 0 (fxfirst-set-bit 1))
(test-equal 3 (fxfirst-set-bit 40))
(test-equal -1 (fxfirst-set-bit 0))
(test-equal 2 (fxfirst-set-bit -28))
(test-equal 60 (fxfirst-set-bit fx-least))
(test-equal #b1010 (fxbit-field #b1101101010 0 4))
(test-equal #b101101 (fxbit-field #b1101101010 3 9))
(test-equal 1 (fxbit-field 6 2 999))
(test-equal 3 (fxbit-field 6 1 3))
(test-equal 255 (fxbit-field -1 0 8))
(test-error (fxbit-field -1 0 61))
(test-error (fxbit-field 6 3 2))
(test-error (fxbit-field 0 -1 3))
(test-error (fxbit-field-rotate 1 1 -1 3))
(test-error (fxbit-field-reverse 1 -1 3))
(test-equal #b110 (fxbit-field-rotate #b110 0 0 10))
(test-equal #b110 (fxbit-field-rotate #b110 1 1 2))
(test-equal #b1010 (fxbit-field-rotate #b110 1 2 4))
(test-equal #b1011 (fxbit-field-rotate #b0111 -1 1 4))
(test-equal 1 (fxbit-field-rotate fx-least 1 0 61))
(test-equal fx-least (fxbit-field-rotate 1 60 0 61))
(test-error (fxbit-field-rotate 1 1 0 62))
(test-equal 6 (fxbit-field-reverse 6 1 3))
(test-equal 12 (fxbit-field-reverse 6 1 4))
(test-equal #x80000000 (fxbit-field-reverse 1 0 32))
(test-equal #x20000000 (fxbit-field-reverse 1 0 30))
(test-equal fx-least (fxbit-field-reverse 1 0 61))
(test-equal 1 (fxbit-field-reverse fx-least 0 61))

(test-end)
