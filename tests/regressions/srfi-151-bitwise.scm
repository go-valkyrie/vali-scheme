;;; requirement: (srfi 151) bitwise operations are available, over fixnums and bignums with two's-complement semantics
;;; found-in: SRFI audit
;;; kind: scheme

(import (scheme base) (srfi 64) (srfi 151))

(test-begin "srfi-151")

;; Basic operations.
(test-equal -11 (bitwise-not 10))
(test-equal 36 (bitwise-not -37))
(test-equal 11 (bitwise-ior 3 10))
(test-equal 10 (bitwise-and 11 26))
(test-equal 9 (bitwise-xor 3 10))
(test-equal -42 (bitwise-eqv 37 12))
(test-equal 4 (bitwise-and 37 12))
(test-equal -1 (bitwise-and))
(test-equal 0 (bitwise-ior))
(test-equal 0 (bitwise-xor))
(test-equal -1 (bitwise-eqv))
(test-equal 7 (bitwise-and 7))
(test-equal 1 (bitwise-and 7 3 9))
;; bitwise-eqv of three is the nested eqv, not "all three agree".
(test-equal (bitwise-eqv 1 (bitwise-eqv 2 3)) (bitwise-eqv 1 2 3))
(test-equal -11 (bitwise-nand 11 26))
(test-equal -28 (bitwise-nor 11 26))
(test-equal 16 (bitwise-andc1 11 26))
(test-equal 1 (bitwise-andc2 11 26))
(test-equal -2 (bitwise-orc1 11 26))
(test-equal -17 (bitwise-orc2 11 26))

;; Shifts.
(test-equal 32 (arithmetic-shift 8 2))
(test-equal 4 (arithmetic-shift 4 0))
(test-equal 4 (arithmetic-shift 8 -1))
(test-equal -79 (arithmetic-shift -100000000000000000000000000000000 -100))
(test-equal -3 (arithmetic-shift -5 -1))
(test-equal -1 (arithmetic-shift -1 -1000))
(test-equal 0 (arithmetic-shift 1 -1000))
(test-equal (expt 2 100) (arithmetic-shift 1 100))
(test-equal (- (expt 2 100)) (arithmetic-shift -1 100))
(test-equal 0 (arithmetic-shift 0 (expt 10 20)))
(test-equal -1 (arithmetic-shift -1 (- (expt 10 20))))
;; Shifts by huge counts are refused, not allocated.
(test-error (arithmetic-shift 1 (expt 10 12)))
(test-error (arithmetic-shift 1 (expt 10 30)))
(test-error (arithmetic-shift -1 (expt 10 12)))

;; Counting.
(test-equal 0 (bit-count 0))
(test-equal 0 (bit-count -1))
(test-equal 3 (bit-count 7))
(test-equal 3 (bit-count 13))
(test-equal 2 (bit-count -13))
(test-equal 4 (bit-count 30))
(test-equal 4 (bit-count -30))
(test-equal 1 (bit-count (expt 2 100)))
(test-equal 100 (bit-count (- (expt 2 100))))
(test-equal 1 (bit-count (- (+ 1 (expt 2 100)))))
(test-equal 0 (integer-length 0))
(test-equal 1 (integer-length 1))
(test-equal 0 (integer-length -1))
(test-equal 3 (integer-length 7))
(test-equal 3 (integer-length -7))
(test-equal 4 (integer-length 8))
(test-equal 3 (integer-length -8))
(test-equal 101 (integer-length (expt 2 100)))

;; bitwise-if.
(test-equal 9 (bitwise-if 3 1 8))
(test-equal 0 (bitwise-if 3 8 1))
(test-equal 3 (bitwise-if 1 1 2))
(test-equal #b00110011 (bitwise-if #b00111100 #b11110000 #b00001111))

;; Single bits.
(test-equal #f (bit-set? 1 1))
(test-equal #t (bit-set? 0 1))
(test-equal #t (bit-set? 3 10))
(test-equal #t (bit-set? 1000000 -1))
(test-equal #t (bit-set? 2 6))
(test-equal #f (bit-set? 0 6))
(test-equal #t (bit-set? (expt 10 30) -1))
(test-equal #f (bit-set? (expt 10 30) 1))
(test-equal #b1 (copy-bit 0 0 #t))
(test-equal #b100 (copy-bit 2 0 #t))
(test-equal #b1011 (copy-bit 2 #b1111 #f))
(test-equal (expt 2 100) (copy-bit 100 0 #t))
(test-equal -1 (copy-bit 100 -1 #t))
(test-error (copy-bit (expt 10 12) 0 #t))
(test-equal #b1 (bit-swap 0 2 4))
(test-equal #t (any-bit-set? 3 6))
(test-equal #f (any-bit-set? 3 12))
(test-equal #t (every-bit-set? 4 6))
(test-equal #f (every-bit-set? 7 6))
(test-equal 0 (first-set-bit 1))
(test-equal 1 (first-set-bit 2))
(test-equal -1 (first-set-bit 0))
(test-equal 3 (first-set-bit 40))
(test-equal 2 (first-set-bit -28))
(test-equal 99 (first-set-bit (expt 2 99)))
(test-equal 99 (first-set-bit (expt -2 99)))

;; Bit fields.
(test-equal #b1010 (bit-field #b1101101010 0 4))
(test-equal #b101101 (bit-field #b1101101010 3 9))
(test-equal #b10110 (bit-field #b1101101010 4 9))
(test-equal #b110110 (bit-field #b1101101010 4 10))
(test-equal 0 (bit-field 6 0 1))
(test-equal 3 (bit-field 6 1 3))
(test-equal 1 (bit-field 6 2 999))
(test-equal 1 (bit-field #x100000000000000000000000000000000 128 129))
(test-equal 255 (bit-field -1 0 8))
(test-equal #t (bit-field-any? #b1001001 1 6))
(test-equal #f (bit-field-any? #b1000001 1 6))
(test-equal #t (bit-field-every? #b1011110 1 5))
(test-equal #f (bit-field-every? #b1011010 1 5))
(test-equal #b100000 (bit-field-clear #b101010 1 4))
(test-equal #b101110 (bit-field-set #b101010 1 4))
(test-equal #b100100 (bit-field-replace #b101010 #b010 1 4))
(test-equal #b111 (bit-field-replace #b110 1 0 1))
(test-equal #b110 (bit-field-replace #b110 1 1 2))
(test-equal #b1001 (bit-field-replace-same #b1111 #b0000 1 3))
(test-equal #b110 (bit-field-rotate #b110 0 0 10))
(test-equal #b110 (bit-field-rotate #b110 0 0 256))
(test-equal 1 (bit-field-rotate #x100000000000000000000000000000000 1 0 129))
(test-equal #b110 (bit-field-rotate #b110 1 1 2))
(test-equal #b1010 (bit-field-rotate #b110 1 2 4))
(test-equal #b1011 (bit-field-rotate #b0111 -1 1 4))
(test-equal 6 (bit-field-reverse 6 1 3))
(test-equal 12 (bit-field-reverse 6 1 4))
(test-equal #x80000000 (bit-field-reverse 1 0 32))
(test-equal #x40000000 (bit-field-reverse 1 0 31))
(test-equal #x20000000 (bit-field-reverse 1 0 30))
(test-equal 5 (bit-field-reverse #x140000000000000000000000000000000 0 129))

;; Conversion.
(test-equal '(#t #f #t #f #t #t #t) (bits->list #b1110101))
(test-equal '(#t #t #f #f #f) (bits->list 3 5))
(test-equal '(#f #t #t #f) (bits->list 6 4))
(test-equal '#(#t #f #t #f #t #t #t) (bits->vector #b1110101))
(test-equal #b1110101 (list->bits '(#t #f #t #f #t #t #t)))
(test-equal #b111010100 (list->bits '(#f #f #t #f #t #f #t #t #t)))
(test-equal 6 (list->bits '(#f #t #t)))
(test-equal 6 (list->bits '(#f #t #t #f)))
(test-equal 12 (list->bits '(#f #f #t #t)))
(test-equal #b1110101 (vector->bits '#(#t #f #t #f #t #t #t)))
(test-equal 12 (vector->bits '#(#f #f #t #t)))
(test-equal #b1110101 (bits #t #f #t #f #t #t #t))
(test-equal #b111010100 (bits #f #f #t #f #t #f #t #t #t))
(test-error (list->bits '(#t 1)))
(test-error (bits->list -1))
(test-error (bits->list -1 3))
(test-error (bits->vector -1))
(test-equal '() (bits->list 0))
(test-error (bits->list 6 -1))
(test-error (bits->list 6 3 4))
(test-error (bits->list 6 1.0))
(test-error (bits->vector 6 -1))
(test-error (bits->vector 6 3 4))
(test-equal '#(#f #t #t #f) (bits->vector 6 4))
(test-equal (expt 2 100) (list->bits (append (make-list 100 #f) '(#t))))

;; Fold, unfold, generate.
(test-equal '(#t #f #t #f #t #t #t) (bitwise-fold cons '() #b1010111))
(test-equal 5
  (let ((count 0))
    (bitwise-for-each (lambda (b) (if b (set! count (+ count 1))))
                      #b1010111)
    count))
(test-equal #b101010101
  (bitwise-unfold (lambda (i) (= i 10)) even? (lambda (i) (+ i 1)) 0))
(let ((g (make-bitwise-generator #b110)))
  (test-equal #f (g))
  (test-equal #t (g))
  (test-equal #t (g))
  (test-equal #f (g)))

;; Fixnum boundaries (fixnums are 61 bits) and bignums.
(define fx-max (- (expt 2 60) 1))
(define fx-min (- (expt 2 60)))
(test-equal (expt 2 61) (+ 1 (bitwise-ior fx-max (expt 2 60) fx-max)))
(test-equal (- (expt 2 61) 1) (bitwise-ior fx-max (expt 2 60)))
(test-equal fx-min (bitwise-not fx-max))
(test-equal fx-max (bitwise-not fx-min))
(test-equal (- fx-min 1) (bitwise-not (+ fx-max 1)))
(test-equal fx-min (bitwise-and fx-min -1))
(test-equal (- fx-min 1) (bitwise-and (- fx-min 1) -1))
(test-equal (- fx-min 1) (bitwise-xor fx-min -1 -1 fx-min (- fx-min 1)))
(test-equal fx-max (arithmetic-shift fx-max 0))
(test-equal (expt 2 61) (arithmetic-shift (expt 2 60) 1))
(test-equal (expt 2 60) (arithmetic-shift (expt 2 61) -1))
(test-equal 61 (integer-length (expt 2 60)))
(test-equal 60 (integer-length fx-min))
(test-equal 61 (integer-length (- fx-min 1)))
(test-equal (expt 2 200) (bitwise-ior (expt 2 200) 0))
(test-equal 0 (bitwise-and (expt 2 200) (- (expt 2 200) 1)))
(test-equal (- (expt 2 200) 1) (bitwise-xor (expt 2 200) (- (expt 2 201) 1)))
(test-equal (- (expt 2 200)) (bitwise-not (- (expt 2 200) 1)))
(test-equal #t (bit-set? 200 (expt 2 200)))
(test-equal #f (bit-set? 199 (expt 2 200)))
(test-equal 200 (first-set-bit (expt 2 200)))
(test-equal (expt 2 150) (bit-field (+ (expt 2 200) (expt 2 150)) 0 151 ))

;; Bit-field operations refuse a negative or reversed field.
(test-error (bit-field-clear 5 -1 2))
(test-error (bit-field-set 5 -1 2))
(test-error (bit-field-every? 5 -1 2))
(test-error (bit-field-replace 5 1 -1 2))
(test-error (bit-field-replace-same 5 1 -1 2))
(test-error (bit-field-clear 5 3 2))
(test-error (bit-field-rotate 5 1 -1 2))
(test-error (bit-field-reverse 5 -1 2))
(test-error (bit-field-any? 5 -1 2))

;; The size cap: a result has at most 2^25 bits, however it is built.
(test-assert (= (integer-length (copy-bit (- (expt 2 25) 1) 0 #t)) (expt 2 25)))
(test-error (copy-bit (expt 2 25) 0 #t))
(test-error (copy-bit (+ (expt 2 25) 1) 0 #t))
(test-error (copy-bit (expt 2 25) -1 #f))
(test-equal 0 (copy-bit (expt 2 25) 0 #f))
(test-assert (= (integer-length (arithmetic-shift 1 (- (expt 2 25) 1))) (expt 2 25)))
(test-error (arithmetic-shift 1 (expt 2 25)))

;; Arguments must be exact integers.
(test-error (bitwise-and 1.0 2))
(test-error (bitwise-not 1/2))
(test-error (arithmetic-shift 1 1.0))
(test-error (bit-set? -1 5))
(test-error (bit-field 5 3 2))
(test-error (bit-count 'a))

(test-end)
