;;; requirement: (srfi 125) hash tables over (srfi 128) comparators
;;; found-in: SRFI audit
;;; kind: scheme

;; Every procedure of the SRFI, then tables of every kind of key, which a
;; memory strategy that freed a key too early, or moved one, would break.
;; (This test runs under every strategy.)

(import (scheme base) (scheme char) (scheme complex) (srfi 1) (srfi 64) (srfi 128) (srfi 125))

(test-begin "srfi-125")
(test-assert (memq 'srfi-125 (features)))

(define (sort-keys keys)
  (let insert-all ((xs keys) (acc '()))
    (if (null? xs)
        acc
        (insert-all (cdr xs)
                    (let insert ((acc acc))
                      (cond ((null? acc) (list (car xs)))
                            ((<? (make-default-comparator) (car xs) (car acc))
                             (cons (car xs) acc))
                            (else (cons (car acc) (insert (cdr acc))))))))))

(define (sorted-alist table)
  (let insert-all ((xs (hash-table->alist table)) (acc '()))
    (if (null? xs)
        acc
        (insert-all (cdr xs)
                    (let insert ((acc acc))
                      (cond ((null? acc) (list (car xs)))
                            ((<? (make-default-comparator) (caar xs) (caar acc))
                             (cons (car xs) acc))
                            (else (cons (car acc) (insert (cdr acc))))))))))

(define string-c (make-comparator string? string=? string<? string-hash))
(define default-c (make-default-comparator))

;; Constructors and the basic operations.
(test-group "basics"
  (define t (make-hash-table default-c))
  (test-assert (hash-table? t))
  (test-assert (not (hash-table? '())))
  (test-assert (hash-table-empty? t))
  (test-eqv 0 (hash-table-size t))
  (hash-table-set! t 'a 1)
  (hash-table-set! t 'b 2 'c 3)
  (test-eqv 3 (hash-table-size t))
  (test-assert (not (hash-table-empty? t)))
  (test-eqv 1 (hash-table-ref t 'a))
  (test-eqv 3 (hash-table-ref t 'c))
  (test-eqv 9 (hash-table-ref t 'z (lambda () 9)))
  (test-eqv 10 (hash-table-ref t 'a (lambda () 9) (lambda (v) (* v 10))))
  (test-error (hash-table-ref t 'z))
  (test-eqv 'none (hash-table-ref/default t 'z 'none))
  (test-eqv 2 (hash-table-ref/default t 'b 'none))
  (test-assert (hash-table-contains? t 'a))
  (test-assert (hash-table-exists? t 'a))
  (test-assert (not (hash-table-contains? t 'z)))
  (hash-table-set! t 'a 100)
  (test-eqv 100 (hash-table-ref t 'a))
  (test-eqv 3 (hash-table-size t))
  (test-eqv 2 (hash-table-delete! t 'a 'b 'nothing))
  (test-eqv 1 (hash-table-size t))
  (test-assert (not (hash-table-contains? t 'a)))
  (test-assert (hash-table-mutable? t))
  (test-assert (eq? (comparator-equality-predicate default-c)
                    (hash-table-equivalence-function t)))
  (test-assert (eq? (comparator-hash-function default-c)
                    (hash-table-hash-function t)))
  (hash-table-clear! t)
  (test-assert (hash-table-empty? t))
  (test-error (hash-table-set! t 'odd))
  (test-error (hash-table-ref 'not-a-table 1)))

(test-group "constructors"
  (define t (hash-table string-c "a" 1 "b" 2))
  (define a (alist->hash-table '((a . 1) (b . 2) (a . 3)) default-c))
  (define u (hash-table-unfold (lambda (n) (> n 5))
                               (lambda (n) (values n (* n n)))
                               (lambda (n) (+ n 1))
                               1 default-c))
  (test-eqv 2 (hash-table-size t))
  (test-eqv 2 (hash-table-ref t (string #\b)))
  (test-eqv 5 (hash-table-size u))
  (test-eqv 16 (hash-table-ref u 4))
  (test-eqv 2 (hash-table-size a))
  (test-eqv 1 (hash-table-ref a 'a))
  ;; Extra arguments: a capacity, and feature hints that are accepted.
  (test-assert (hash-table? (make-hash-table default-c 100)))
  (test-assert (hash-table? (make-hash-table default-c 'weak-keys 'thread-safe)))
  (test-assert (hash-table? (make-hash-table default-c 'ephemeral-values 4)))
  (test-error (make-hash-table default-c car))
  (test-error (make-hash-table 'nonsense))
  (test-error (make-hash-table default-c 'no-such-hint))
  ;; The SRFI 69 forms, with a predicate for a comparator.
  (test-assert (hash-table? (make-hash-table equal?)))
  (test-assert (hash-table? (make-hash-table string=? string-hash)))
  (test-assert (hash-table? (make-hash-table)))
  (test-error (make-hash-table (lambda (a b) (eq? a b))))
  (let ((h (alist->hash-table '(("x" . 1)) string=?)))
    (test-eqv 1 (hash-table-ref h "x")))
  (let ((h (alist->hash-table '(("x" . 1)) string-ci=?)))
    (test-eqv 1 (hash-table-ref h "X"))))

(test-group "update"
  (define t (make-hash-table default-c))
  (hash-table-update! t 'n (lambda (v) (+ v 1)) (lambda () 0))
  (hash-table-update! t 'n (lambda (v) (+ v 1)) (lambda () 0))
  (test-eqv 2 (hash-table-ref t 'n))
  (hash-table-update! t 'n (lambda (v) (* v 10)) (lambda () 0)
                      (lambda (v) (+ v 1)))
  (test-eqv 30 (hash-table-ref t 'n))
  (test-error (hash-table-update! t 'missing (lambda (v) v)))
  (hash-table-update!/default t 'm (lambda (v) (cons 1 v)) '())
  (hash-table-update!/default t 'm (lambda (v) (cons 2 v)) '())
  (test-equal '(2 1) (hash-table-ref t 'm))
  (test-eqv 5 (hash-table-intern! t 'i (lambda () 5)))
  (test-eqv 5 (hash-table-intern! t 'i (lambda () 6)))
  (test-eqv 5 (hash-table-ref t 'i)))

(test-group "whole table"
  (define t (alist->hash-table '((1 . one) (2 . two) (3 . three)) default-c))
  (define m (hash-table-map (lambda (v) (symbol->string v)) default-c t))
  (test-equal '(1 2 3) (sort-keys (hash-table-keys t)))
  (test-equal '(one three two)
              (sort-keys (hash-table-values t)))
  (call-with-values (lambda () (hash-table-entries t))
    (lambda (keys values)
      (test-equal '(1 2 3) (sort-keys keys))
      (test-eq (hash-table-ref t (car keys)) (car values))))
  (test-equal '((1 . one) (2 . two) (3 . three)) (sorted-alist t))
  (test-eqv 2 (hash-table-find (lambda (k v) (and (eq? v 'two) k)) t
                               (lambda () 'no)))
  (test-eq 'no (hash-table-find (lambda (k v) #f) t (lambda () 'no)))
  (test-eqv 2 (hash-table-count (lambda (k v) (odd? k)) t))
  (test-eqv 6 (hash-table-fold (lambda (k v acc) (+ k acc)) 0 t))
  (test-eqv 6 (hash-table-fold t (lambda (k v acc) (+ k acc)) 0))
  (let ((sum 0))
    (hash-table-for-each (lambda (k v) (set! sum (+ sum k))) t)
    (test-eqv 6 sum)
    (hash-table-walk t (lambda (k v) (set! sum (+ sum k))))
    (test-eqv 12 sum))
  (test-equal '(2 4 6)
              (sort-keys (hash-table-map->list (lambda (k v) (* 2 k)) t)))
  (test-equal "two" (hash-table-ref m 2))
  (test-eqv 3 (hash-table-size m))
  (hash-table-map! (lambda (k v) (* k 100)) t)
  (test-equal '((1 . 100) (2 . 200) (3 . 300)) (sorted-alist t))
  (hash-table-prune! (lambda (k v) (even? k)) t)
  (test-equal '((1 . 100) (3 . 300)) (sorted-alist t))
  (call-with-values (lambda () (hash-table-pop! t))
    (lambda (k v) (test-eqv (* k 100) v)))
  (test-eqv 1 (hash-table-size t))
  (hash-table-pop! t)
  (test-error (hash-table-pop! t)))

(test-group "copies"
  (define t (alist->hash-table '((a . 1) (b . 2)) default-c))
  (define c (hash-table-copy t))
  (define e (hash-table-empty-copy t))
  (test-assert (not (eq? t c)))
  (hash-table-set! c 'z 26)
  (test-eqv 2 (hash-table-size t))
  (test-eqv 3 (hash-table-size c))
  (test-assert (hash-table-mutable? (hash-table-copy t #f)))
  (test-assert (hash-table-empty? e))
  (test-eq (hash-table-equivalence-function t) (hash-table-equivalence-function e))
  (test-assert (hash-table=? default-c t (alist->hash-table '((b . 2) (a . 1)) default-c)))
  (test-assert (not (hash-table=? default-c t c)))
  (test-assert (not (hash-table=? default-c t (alist->hash-table '((a . 1) (b . 3)) default-c)))))

(test-group "sets"
  (define (make . alist) (alist->hash-table alist default-c))
  (define u (hash-table-union! (make '(a . 1) '(b . 2)) (make '(b . 20) '(c . 3))))
  (define m (hash-table-merge! (make '(a . 1)) (make '(a . 2) '(d . 4))))
  (define i (hash-table-intersection! (make '(a . 1) '(b . 2)) (make '(b . 20) '(c . 3))))
  (define d (hash-table-difference! (make '(a . 1) '(b . 2)) (make '(b . 20) '(c . 3))))
  (define x (hash-table-xor! (make '(a . 1) '(b . 2)) (make '(b . 20) '(c . 3))))
  (test-equal '((a . 1) (b . 2) (c . 3)) (sorted-alist u))
  (test-equal '((a . 1) (d . 4)) (sorted-alist m))
  (test-equal '((b . 2)) (sorted-alist i))
  (test-equal '((a . 1)) (sorted-alist d))
  (test-equal '((a . 1) (c . 3)) (sorted-alist x)))

(test-group "deprecated names"
  (test-assert (= (hash 'a) (hash 'a)))
  (test-assert (< (hash "abc" 10) 10))
  (test-assert (= (hash-by-identity 'a) (hash-by-identity 'a)))
  (test-assert (< (hash-by-identity 'a 7) 7))
  (test-assert (= (string-hash "a") (string-hash "a" (hash-bound))))
  (test-assert (= (string-ci-hash "A") (string-ci-hash "a"))))

;; Tables grow: many keys, then every one is still found, and deletion
;; of half leaves the other half.
(test-group "growth"
  (define t (make-hash-table default-c))
  (do ((i 0 (+ i 1))) ((= i 5000))
    (hash-table-set! t i (* i i)))
  (test-eqv 5000 (hash-table-size t))
  (test-assert (let loop ((i 0))
                 (or (= i 5000)
                     (and (eqv? (hash-table-ref/default t i #f) (* i i))
                          (loop (+ i 1))))))
  (do ((i 0 (+ i 2))) ((>= i 5000))
    (hash-table-delete! t i))
  (test-eqv 2500 (hash-table-size t))
  (test-assert (not (hash-table-contains? t 10)))
  (test-assert (hash-table-contains? t 11)))

;; Keys of every kind, under every comparator that suits them.
(define-record-type <box> (make-box v) box? (v unbox))
(define-syntax each-comparator
  (syntax-rules ()
    ((_ (c ...) body) (for-each (lambda (cmp) (body cmp)) (list c ...)))))

(define (check-keys make-key cmp)
  ;; Two tables' worth of fresh keys: `make-key` makes a new, equal key each
  ;; time it is called with the same number.
  (let ((t (make-hash-table cmp)) (keys (map make-key (iota 300))))
    (for-each (lambda (k n) (hash-table-set! t k n)) keys (iota 300))
    (test-eqv 300 (hash-table-size t))
    (test-assert
     (every (lambda (k n) (eqv? n (hash-table-ref/default t k #f))) keys (iota 300)))
    (hash-table-delete! t (car keys))
    (test-eqv 299 (hash-table-size t))
    t))

(test-group "keys that are compared by identity"
  (define eq-c (make-eq-comparator))
  (define eqv-c (make-eqv-comparator))
  (define strings (list (make-string 1 #\x) (make-string 1 #\x)))
  (each-comparator (eq-c eqv-c)
    (lambda (cmp)
      (check-keys (lambda (n) (list n)) cmp)
      (check-keys (lambda (n) (vector n)) cmp)
      (check-keys (lambda (n) (make-string 2 #\a)) cmp)
      (check-keys (lambda (n) (make-box n)) cmp)
      (check-keys (lambda (n) (lambda (x) (+ x n))) cmp)
      (check-keys (lambda (n) (bytevector (modulo n 256) (quotient n 256))) cmp)
      (check-keys (lambda (n) (string->symbol (number->string n))) cmp)
      (check-keys (lambda (n) (integer->char (+ 100 n))) cmp)
      (check-keys (lambda (n) n) cmp)))
  ;; Equal but not identical keys are different under eq and eqv.
  (let ((t (make-hash-table eq-c)))
    (hash-table-set! t (car strings) 1)
    (test-assert (not (hash-table-contains? t (cadr strings))))
    (test-assert (hash-table-contains? t (car strings))))
  ;; Numbers: eqv keys by value and exactness.
  (let ((t (make-hash-table eqv-c)))
    (hash-table-set! t 2 'exact)
    (hash-table-set! t 2.0 'inexact)
    (hash-table-set! t (expt 10 40) 'big)
    (hash-table-set! t 1/3 'ratio)
    (hash-table-set! t (make-rectangular 1 2) 'complex)
    (test-eqv 5 (hash-table-size t))
    (test-eq 'exact (hash-table-ref t 2))
    (test-eq 'inexact (hash-table-ref t 2.0))
    (test-eq 'big (hash-table-ref t (* (expt 10 20) (expt 10 20))))
    (test-eq 'ratio (hash-table-ref t (/ 2 6)))
    (test-eq 'complex (hash-table-ref t (make-rectangular 1 2))))
  ;; eq on a table of objects that stay alive: a collector must not lose them.
  (let ((t (make-hash-table eq-c)) (objects (map (lambda (n) (list n)) (iota 2000))))
    (for-each (lambda (o) (hash-table-set! t o (car o))) objects)
    (make-list 20000 'garbage)
    (test-assert (every (lambda (o) (eqv? (car o) (hash-table-ref t o))) objects))))

(test-group "keys that are compared by value"
  (define equal-c (make-equal-comparator))
  (each-comparator (equal-c default-c)
    (lambda (cmp)
      (check-keys (lambda (n) (list n (list "s" n) #(1 2))) cmp)
      (check-keys (lambda (n) (vector n (list n) (string #\a))) cmp)
      (check-keys (lambda (n) (string-append "k" (number->string n))) cmp)
      (check-keys (lambda (n) (bytevector (modulo n 256) (quotient n 256))) cmp)
      (check-keys (lambda (n) (cons n n)) cmp)
      (check-keys (lambda (n) (string->symbol (string-append "s" (number->string n)))) cmp)
      (check-keys (lambda (n) (* n 1/3)) cmp)
      (check-keys (lambda (n) (+ n .5)) cmp)
      (check-keys (lambda (n) (* n (expt 10 30))) cmp)
      (check-keys (lambda (n) (make-rectangular n 1)) cmp)
      (check-keys (lambda (n) (integer->char (+ 100 n))) cmp)))
  ;; Equal, not identical, keys find each other.
  (let ((t (make-hash-table equal-c)))
    (hash-table-set! t (list 1 "two" #(3)) 'found)
    (test-eq 'found (hash-table-ref t (list 1 (string #\t #\w #\o) (vector 3))))
    (hash-table-set! t #t 'true)
    (hash-table-set! t '() 'nil)
    (hash-table-set! t #\a 'char)
    (hash-table-set! t "" 'empty)
    (test-eq 'true (hash-table-ref t #t))
    (test-eq 'nil (hash-table-ref t '()))
    (test-eq 'char (hash-table-ref t #\a))
    (test-eq 'empty (hash-table-ref t (make-string 0)))
    (test-assert (not (hash-table-contains? t 2))))
  ;; The default comparator treats 2 and 2.0 as the same key; equal? does not.
  (let ((t (make-hash-table default-c)))
    (hash-table-set! t 2 'a)
    (hash-table-set! t 2.0 'b)
    (hash-table-set! t 1/2 'c)
    (hash-table-set! t .5 'd)
    (test-eqv 2 (hash-table-size t))
    (test-eq 'b (hash-table-ref t 2))
    (test-eq 'd (hash-table-ref t 1/2)))
  (let ((t (make-hash-table equal-c)))
    (hash-table-set! t 2 'a)
    (hash-table-set! t 2.0 'b)
    (test-eqv 2 (hash-table-size t)))
  ;; Case-insensitive strings.
  (let ((t (make-hash-table (make-comparator string? string-ci=? #f string-ci-hash))))
    (hash-table-set! t "Hello" 1)
    (test-eqv 1 (hash-table-ref t "HELLO"))
    (hash-table-set! t "hello" 2)
    (test-eqv 1 (hash-table-size t)))
  ;; SRFI 69 tables from predicates.
  (each-comparator (equal? eqv? eq? =)
    (lambda (eqf)
      (let ((t (make-hash-table eqf)))
        (hash-table-set! t 1 'x)
        (test-eq 'x (hash-table-ref/default t 1 #f)))))
  (each-comparator (string=? string-ci=?)
    (lambda (eqf)
      (let ((t (make-hash-table eqf)))
        (hash-table-set! t "k" 'x)
        (test-eq 'x (hash-table-ref/default t (string #\k) #f))))))

;; Mutating a key's contents is an error, but a table of keys that are
;; changed elsewhere (not in a way that changes their hash) keeps working.
(test-group "mutable keys under eq"
  (define t (make-hash-table (make-eq-comparator)))
  (define k (list 1 2 3))
  (hash-table-set! t k 'v)
  (set-car! k 100)
  (set-cdr! (cddr k) '(4))
  (test-eq 'v (hash-table-ref t k)))

;; Keys that are deep, long or circular hash and compare in bounded time.
(test-group "deep and circular keys"
  (define (nest n)
    (let loop ((n n) (x '()))
      (if (= n 0) x (loop (- n 1) (list x)))))
  (define (nest-vectors n)
    (let loop ((n n) (x 0))
      (if (= n 0) x (loop (- n 1) (vector x)))))
  (define circular (list 1 2 3))
  (define circular-car (list 0))
  (define circular-vector (vector 1 #f))
  (define t (make-hash-table (make-equal-comparator)))
  (set-cdr! (cddr circular) circular)
  (set-car! circular-car circular-car)
  (vector-set! circular-vector 1 circular-vector)
  (hash-table-set! t (nest 100000) 'deep)
  (hash-table-set! t (nest-vectors 100000) 'deep-vector)
  (hash-table-set! t (make-list 100000 7) 'long)
  (hash-table-set! t (make-vector 100000 7) 'long-vector)
  (hash-table-set! t circular 'circular)
  (hash-table-set! t circular-car 'circular-car)
  (hash-table-set! t circular-vector 'circular-vector)
  (test-eq 'deep (hash-table-ref t (nest 100000)))
  (test-eq 'deep-vector (hash-table-ref t (nest-vectors 100000)))
  (test-eq 'long (hash-table-ref t (make-list 100000 7)))
  (test-eq 'long-vector (hash-table-ref t (make-vector 100000 7)))
  (test-eq 'circular (hash-table-ref t circular))
  (test-eq 'circular-car (hash-table-ref t circular-car))
  (test-eq 'circular-vector (hash-table-ref t circular-vector))
  ;; Under eq and the default comparator too.
  (let ((e (make-hash-table (make-eq-comparator))))
    (hash-table-set! e circular 1)
    (hash-table-set! e (nest 100000) 2)
    (test-eqv 1 (hash-table-ref e circular)))
  (let ((e (make-hash-table default-c)))
    (hash-table-set! e (make-list 100000 7) 1)
    (test-eqv 1 (hash-table-ref e (make-list 100000 7))))
  (test-assert (< (default-hash circular) (hash-bound))))

(test-end)
