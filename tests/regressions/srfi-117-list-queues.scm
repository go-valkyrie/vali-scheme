;;; requirement: (srfi 117) list queues
;;; found-in: SRFI audit
;;; kind: scheme

;; The SRFI's own tests (by John Cowan and Alex Shinn), ported to
;; SRFI 64, and more for the cases they leave out.

(import (scheme base) (srfi 64) (srfi 117))

(test-begin "srfi-117")
(test-assert (memq 'srfi-117 (features)))

(test-group "simple"
  (define x #f)
  (define x1 #f)
  (define x2 #f)
  (define y #f)
  (define z #f)
  (define z2 #f)
  (test-equal '(1 1 1) (list-queue-list (make-list-queue '(1 1 1))))
  (set! x (list-queue 1 2 3))
  (test-equal '(1 2 3) (list-queue-list x))
  (set! x1 (list 1 2 3))
  (set! x2 (make-list-queue x1 (cddr x1)))
  (test-equal 3 (list-queue-back x2))
  (set! y (list-queue 4 5))
  (test-assert (list-queue? y))
  (set! z (list-queue-append x y))
  (test-equal '(1 2 3 4 5) (list-queue-list z))
  (set! z2 (list-queue-append! x (list-queue-copy y)))
  (test-equal '(1 2 3 4 5) (list-queue-list z2))
  (test-equal 1 (list-queue-front z))
  (test-equal 5 (list-queue-back z))
  (list-queue-remove-front! y)
  (test-equal '(5) (list-queue-list y))
  (list-queue-remove-back! y)
  (test-assert (list-queue-empty? y))
  (test-error (list-queue-remove-front! y))
  (test-error (list-queue-remove-back! y))
  (test-equal '(1 2 3 4 5) (list-queue-list z))
  (test-equal '(1 2 3 4 5) (list-queue-remove-all! z2))
  (test-assert (list-queue-empty? z2))
  (list-queue-remove-all! z)
  (list-queue-add-front! z 1)
  (list-queue-add-front! z 0)
  (list-queue-add-back! z 2)
  (list-queue-add-back! z 3)
  (test-equal '(0 1 2 3) (list-queue-list z)))

(test-group "whole"
  (define a (list-queue 1 2 3))
  (define b (list-queue-copy a))
  (define c #f)
  (test-equal '(1 2 3) (list-queue-list b))
  (list-queue-add-front! b 0)
  (test-equal '(1 2 3) (list-queue-list a))
  (test-equal 4 (length (list-queue-list b)))
  (set! c (list-queue-concatenate (list a b)))
  (test-equal '(1 2 3 0 1 2 3) (list-queue-list c)))

(test-group "map"
  (define r (list-queue 1 2 3))
  (define s (list-queue-map (lambda (x) (* x 10)) r))
  (define sum #f)
  (test-equal '(10 20 30) (list-queue-list s))
  (list-queue-map! (lambda (x) (+ x 1)) r)
  (test-equal '(2 3 4) (list-queue-list r))
  (set! sum 0)
  (list-queue-for-each (lambda (x) (set! sum (+ sum x))) s)
  (test-equal 60 sum))

(test-group "conversion"
  (define n (list-queue 5 6))
  (define d #f)
  (define e #f)
  (define f #f)
  (define dx #f)
  (define ex #f)
  (define g #f)
  (define h #f)
  (list-queue-set-list! n (list 1 2))
  (test-equal '(1 2) (list-queue-list n))
  (set! d (list 1 2 3))
  (set! e (cddr d))
  (set! f (make-list-queue d e))
  (set! dx #f)
  (set! ex #f)
  (call-with-values (lambda () (list-queue-first-last f))
    (lambda (first last) (set! dx first) (set! ex last)))
  (test-assert (eq? d dx))
  (test-assert (eq? e ex))
  (test-equal '(1 2 3) (list-queue-list f))
  (list-queue-add-front! f 0)
  (list-queue-add-back! f 4)
  (test-equal '(0 1 2 3 4) (list-queue-list f))
  (set! g (make-list-queue d e))
  (test-equal '(1 2 3 4) (list-queue-list g))
  (set! h (list-queue 5 6))
  (list-queue-set-list! h d e)
  (test-equal '(1 2 3 4) (list-queue-list h)))

(test-group "unfold"
  (define (double x) (* x 2))
  (define (done? x) (> x 3))
  (define (add1 x) (+ x 1))
  (define x (list-queue-unfold done? double add1 0))
  (define y #f)
  (define x0 #f)
  (define x1 #f)
  (define y0 #f)
  (define y1 #f)
  (test-equal '(0 2 4 6) (list-queue-list x))
  (set! y (list-queue-unfold-right done? double add1 0))
  (test-equal '(6 4 2 0) (list-queue-list y))
  (set! x0 (list-queue 8))
  (set! x1 (list-queue-unfold done? double add1 0 x0))
  (test-equal '(0 2 4 6 8) (list-queue-list x1))
  (set! y0 (list-queue 8))
  (set! y1 (list-queue-unfold-right done? double add1 0 y0))
  (test-equal '(8 6 4 2 0) (list-queue-list y1)))

(test-group "edges"
  (define q (list-queue))
  (define a #f)
  (define b #f)
  (define c #f)
  (define d #f)
  (define all #f)
  (define src #f)
  (define app #f)
  (test-assert (list-queue-empty? q))
  (test-equal '() (list-queue-list q))
  (call-with-values (lambda () (list-queue-first-last q))
    (lambda (first last)
      (test-equal '() first)
      (test-equal '() last)))
  (test-error (list-queue-front q))
  (test-error (list-queue-back q))
  (list-queue-add-back! q 1)
  (test-equal 1 (list-queue-front q))
  (test-equal 1 (list-queue-back q))
  (list-queue-add-back! q 2)
  (list-queue-add-back! q 3)
  (test-equal 3 (list-queue-remove-back! q))
  (list-queue-add-back! q 4)
  (test-equal '(1 2 4) (list-queue-list q))
  (test-equal 1 (list-queue-remove-front! q))
  (test-equal 4 (list-queue-remove-back! q))
  (test-equal 2 (list-queue-remove-back! q))
  (test-assert (list-queue-empty? q))
  (list-queue-add-front! q 'a)
  (test-equal 'a (list-queue-back q))
  (set! a (list-queue))
  (set! b (list-queue 1 2))
  (set! c (list-queue))
  (set! d (list-queue 3))
  (set! all (list-queue-append! a b c d))
  (test-equal '(1 2 3) (list-queue-list all))
  (test-equal 3 (list-queue-back all))
  (list-queue-add-back! all 4)
  (test-equal '(1 2 3 4) (list-queue-list all))
  (test-equal '() (list-queue-list (list-queue-append)))
  (test-equal '() (list-queue-list (list-queue-append!)))
  (test-equal '(1 2 3) (list-queue-list (list-queue-append (list-queue 1) (list-queue) (list-queue 2 3))))
  (set! src (list-queue 1 2))
  (set! app (list-queue-append src))
  (list-queue-add-back! src 3)
  (test-equal '(1 2) (list-queue-list app))
  (list-queue-set-list! q (list 7 8 9))
  (test-equal 9 (list-queue-back q))
  (list-queue-set-list! q '())
  (test-assert (list-queue-empty? q))
  (list-queue-add-back! q 1)
  (test-equal '(1) (list-queue-list q))
  (list-queue-map! (lambda (x) x) (list-queue))
  (test-equal '() (list-queue-list (list-queue-map list (list-queue))))
  (test-error (list-queue-front 5))
  (test-assert (not (list-queue? '(1)))))

(test-end "srfi-117")
