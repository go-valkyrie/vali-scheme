;;; requirement: (srfi 144) flonum operations are available, with C99 results for signed zeros, infinities and NaNs
;;; found-in: SRFI audit
;;; kind: scheme

(import (scheme base) (srfi 64) (srfi 144))

(test-begin "srfi-144")

(define-syntax values->list
  (syntax-rules ()
    ((_ e) (call-with-values (lambda () e) list))))

;; Close to `b`, as a relative error.
(define (close? a b)
  (or (fl=? a b)
      (fl<=? (flabs (fl- a b)) (fl* 1e-13 (flmax (flabs a) (flabs b))))))

(define-syntax test-close
  (syntax-rules ()
    ((_ expected expr) (test-assert (close? expected expr)))))

;; The constants agree with the functions that define them.
(test-equal 3.141592653589793 fl-pi)
(test-equal 2.718281828459045 fl-e)
(test-close (flexp 1.) fl-e)
(test-close (fl/ 1. fl-e) fl-1/e)
(test-close (flsquare fl-e) fl-e-2)
(test-close (flexp fl-pi/4) fl-e-pi/4)
(test-close (fl/ 1. (fllog 2.)) fl-log2-e)
(test-close (fl/ 1. (fllog 10.)) fl-log10-e)
(test-close (fllog 2.) fl-log-2)
(test-close (fl/ 1. (fllog 2.)) fl-1/log-2)
(test-close (fllog 3.) fl-log-3)
(test-close (fllog fl-pi) fl-log-pi)
(test-close (fllog 10.) fl-log-10)
(test-close (fl/ 1. (fllog 10.)) fl-1/log-10)
(test-close (fl* 4. (flatan 1.)) fl-pi)
(test-close (fl/ 1. fl-pi) fl-1/pi)
(test-close (fl* 2. fl-pi) fl-2pi)
(test-close (fl/ fl-pi 2.) fl-pi/2)
(test-close (flatan 1.) fl-pi/4)
(test-close (flsquare fl-pi) fl-pi-squared)
(test-close (fl/ fl-pi 180.) fl-degree)
(test-close (fl/ 2. fl-pi) fl-2/pi)
(test-close (fl/ 2. (flsqrt fl-pi)) fl-2/sqrt-pi)
(test-close (flsqrt 2.) fl-sqrt-2)
(test-close (flsqrt 3.) fl-sqrt-3)
(test-close (flsqrt 5.) fl-sqrt-5)
(test-close (flsqrt 10.) fl-sqrt-10)
(test-close (fl/ 1. (flsqrt 2.)) fl-1/sqrt-2)
(test-close (flcbrt 2.) fl-cbrt-2)
(test-close (flcbrt 3.) fl-cbrt-3)
(test-close (flsqrt (flsqrt 2.)) fl-4thrt-2)
(test-close (fl/ (fl+ 1. (flsqrt 5.)) 2.) fl-phi)
(test-close (fllog fl-phi) fl-log-phi)
(test-close (fl/ 1. (fllog fl-phi)) fl-1/log-phi)
(test-close 0.5772156649015329 fl-euler)
(test-close (flexp fl-euler) fl-e-euler)
(test-close (flsin 1.) fl-sin-1)
(test-close (flcos 1.) fl-cos-1)
(test-close (flgamma .5) fl-gamma-1/2)
(test-close (flgamma (fl/ 1. 3.)) fl-gamma-1/3)
(test-close (flgamma (fl/ 2. 3.)) fl-gamma-2/3)

;; Implementation constants.
(test-equal 1.7976931348623157e308 fl-greatest)
(test-equal 4.9406564584124654e-324 fl-least)
(test-assert (fl>? fl-least 0.))
(test-equal 0. (fl/ fl-least 2.))
(test-equal +inf.0 (fl* fl-greatest 2.))
(test-assert (fl>? (fl+ 1. fl-epsilon) 1.))
(test-equal 1. (fl+ 1. (fl/ fl-epsilon 2.)))
(test-assert (boolean? fl-fast-fl+*))
(test-equal fl-integer-exponent-zero (flinteger-exponent 0.))
(test-equal fl-integer-exponent-nan (flinteger-exponent +nan.0))
(test-assert (exact-integer? fl-integer-exponent-zero))

;; Constructors.
(test-equal .5 (flonum 1/2))
(test-equal 1. (flonum 1))
(test-equal 2.5 (flonum 2.5))
(test-assert (eqv? -0. (flonum -0.)))
(test-error (flonum 'a))
(test-error (flonum 1+2i))
(test-equal (fl+ 1. fl-epsilon) (fladjacent 1. 2.))
(test-equal (fl- 1. (fl/ fl-epsilon 2.)) (fladjacent 1. 0.))
(test-equal 1. (fladjacent 1. 1.))
(test-equal fl-least (fladjacent 0. 1.))
(test-equal -3. (flcopysign 3. -0.))
(test-equal 3. (flcopysign -3. 1.))
(test-equal 24. (make-flonum 1.5 4))
(test-equal .375 (make-flonum 1.5 -2))
(test-equal +inf.0 (make-flonum 1. (expt 10 30)))
(test-equal 0. (make-flonum 1. (- (expt 10 30))))

;; Accessors.
(test-equal '(3. .75) (values->list (flinteger-fraction 3.75)))
(test-equal '(-3. -.75) (values->list (flinteger-fraction -3.75)))
(test-equal 3. (flexponent 8.))
(test-equal -inf.0 (flexponent 0.))
(test-equal 3 (flinteger-exponent 8.))
(test-equal -4 (flinteger-exponent .1))
(test-equal '(.5 4) (values->list (flnormalized-fraction-exponent 8.)))
(test-equal '(-.75 2) (values->list (flnormalized-fraction-exponent -3.)))
(test-equal 0 (flsign-bit 1.))
(test-equal 1 (flsign-bit -1.))
(test-equal 1 (flsign-bit -0.))
(test-equal 0 (flsign-bit 0.))

;; Predicates.
(test-assert (flonum? 1.))
(test-assert (flonum? +nan.0))
(test-assert (not (flonum? 1)))
(test-assert (not (flonum? 1/2)))
(test-assert (not (flonum? 'a)))
(test-assert (fl=? 1. 1. 1.))
(test-assert (not (fl=? 1. 1. 2.)))
(test-assert (fl<? 1. 2. 3.))
(test-assert (not (fl<? 1. 3. 3.)))
(test-assert (fl>? 3. 2. 1.))
(test-assert (fl<=? 1. 1. 2.))
(test-assert (fl>=? 2. 2. 1.))
(test-assert (fl=? 0. -0.))
(test-assert (not (fl=? +nan.0 +nan.0)))
(test-assert (not (fl<? +nan.0 1.)))
(test-assert (not (fl>=? 1. +nan.0)))
(test-assert (flunordered? +nan.0 1.))
(test-assert (flunordered? 1. +nan.0))
(test-assert (not (flunordered? 1. 2.)))
(test-assert (flinteger? 2.))
(test-assert (not (flinteger? 2.5)))
(test-assert (not (flinteger? +inf.0)))
(test-assert (not (flinteger? +nan.0)))
(test-assert (flzero? 0.))
(test-assert (flzero? -0.))
(test-assert (not (flzero? 1e-300)))
(test-assert (flpositive? 1.))
(test-assert (not (flpositive? -0.)))
(test-assert (flnegative? -1.))
(test-assert (not (flnegative? -0.)))
(test-assert (flodd? 3.))
(test-assert (not (flodd? 4.)))
(test-assert (flodd? -3.))
(test-assert (fleven? 4.))
(test-assert (fleven? 0.))
(test-assert (not (fleven? 3.)))
(test-error (flodd? 1.5))
(test-error (fleven? +inf.0))
(test-assert (flfinite? 1.))
(test-assert (not (flfinite? +inf.0)))
(test-assert (not (flfinite? +nan.0)))
(test-assert (flinfinite? -inf.0))
(test-assert (not (flinfinite? 1.)))
(test-assert (flnan? +nan.0))
(test-assert (not (flnan? +inf.0)))
(test-assert (flnormalized? 1.))
(test-assert (not (flnormalized? 0.)))
(test-assert (not (flnormalized? 5e-324)))
(test-assert (fldenormalized? 5e-324))
(test-assert (flsubnormal? 5e-324))
(test-assert (not (flsubnormal? 1.)))
(test-assert (eq? flsubnormal? fldenormalized?))
(test-assert (not (fldenormalized? 1.)))
(test-assert (not (fldenormalized? 0.)))

;; Arithmetic.
(test-equal 3. (flmax 1. 3. 2.))
(test-equal 1. (flmin 1. 3. 2.))
(test-equal -inf.0 (flmax))
(test-equal +inf.0 (flmin))
(test-equal 1. (flmax 1. +nan.0))
(test-equal 6. (fl+ 1. 2. 3.))
(test-equal 0. (fl+))
(test-equal 24. (fl* 2. 3. 4.))
(test-equal 1. (fl*))
(test-equal 7. (fl+* 2. 3. 1.))
;; The fused multiply-add rounds once.
(test-equal -4.930380657631324e-32
  (fl+* (fl+ 1. fl-epsilon) (fl- 1. fl-epsilon) -1.))
(test-equal 0. (fl+ (fl* (fl+ 1. fl-epsilon) (fl- 1. fl-epsilon)) -1.))
(test-equal -2. (fl- 2.))
(test-equal 1. (fl- 3. 1. 1.))
(test-equal .25 (fl/ 4.))
(test-equal 2. (fl/ 8. 2. 2.))
(test-equal +inf.0 (fl/ 1. 0.))
(test-assert (flnan? (fl/ 0. 0.)))
(test-equal 5. (flabs -5.))
(test-equal 2. (flabsdiff 5. 3.))
(test-equal 2. (flabsdiff 3. 5.))
(test-equal 2. (flposdiff 5. 3.))
(test-equal 0. (flposdiff 3. 5.))
(test-equal 1. (flsgn 3.))
(test-equal -1. (flsgn -3.))
(test-equal -1. (flsgn -0.))
(test-equal 1. (flnumerator .5))
(test-equal 2. (fldenominator .5))
(test-equal -3. (flnumerator -.75))
(test-equal 4. (fldenominator -.75))
(test-equal 6. (flnumerator 6.))
(test-equal 1. (fldenominator 6.))
(test-equal 3602879701896397. (flnumerator .1))
(test-equal 36028797018963968. (fldenominator .1))
(test-equal +inf.0 (flnumerator +inf.0))
(test-equal 1. (fldenominator +inf.0))
(test-equal 1. (fldenominator 0.))
(test-assert (flnan? (flnumerator +nan.0)))
(test-assert (flnan? (fldenominator +nan.0)))
(test-equal 2. (flfloor 2.7))
(test-equal -3. (flfloor -2.7))
(test-equal 3. (flceiling 2.1))
(test-equal -2. (flceiling -2.7))
(test-equal 2. (flround 2.5))
(test-equal 4. (flround 3.5))
(test-equal -2. (flround -2.5))
(test-equal 3. (flround 2.6))
(test-equal 2. (fltruncate 2.7))
(test-equal -2. (fltruncate -2.7))

;; Exponents and logarithms.
(test-close fl-e (flexp 1.))
(test-equal 1. (flexp 0.))
(test-equal 0. (flexp -inf.0))
(test-equal 1024. (flexp2 10.))
(test-close 1.00000000005e-10 (flexp-1 1e-10))
(test-equal 16. (flsquare 4.))
(test-equal 3. (flsqrt 9.))
(test-assert (eqv? -0. (flsqrt -0.)))
(test-assert (flnan? (flsqrt -1.)))
(test-equal 3. (flcbrt 27.))
(test-equal -2. (flcbrt -8.))
(test-equal 5. (flhypot 3. 4.))
(test-equal +inf.0 (flhypot +inf.0 +nan.0))
(test-equal 1024. (flexpt 2. 10.))
(test-equal .5 (flexpt 2. -1.))
(test-equal 1. (flexpt 0. 0.))
(test-equal 0. (flexpt 0. 2.))
(test-equal 0. (fllog 1.))
(test-equal -inf.0 (fllog 0.))
(test-assert (flnan? (fllog -1.)))
(test-close 9.9999999995e-11 (fllog1+ 1e-10))
(test-equal 3. (fllog2 8.))
(test-equal 3. (fllog10 1000.))
(test-close 3. ((make-fllog-base 2.) 8.))
(test-close 2. ((make-fllog-base 10.) 100.))
(test-error (make-fllog-base 1.))
(test-error (make-fllog-base .5))
(test-error (make-fllog-base 2))

;; Trigonometry.
(test-equal 0. (flsin 0.))
(test-equal 1. (flcos 0.))
(test-equal 0. (fltan 0.))
(test-close fl-pi/2 (flasin 1.))
(test-equal 0. (flacos 1.))
(test-close fl-pi/4 (flatan 1.))
(test-close fl-pi/4 (flatan 1. 1.))
(test-close (fl- fl-pi) (flatan -0. -1.))
(test-close (fl- fl-pi/2) (flatan -1. 0.))
(test-equal 0. (flsinh 0.))
(test-equal 1. (flcosh 0.))
(test-equal 0. (fltanh 0.))
(test-close 0.881373587019543 (flasinh 1.))
(test-equal 0. (flacosh 1.))
(test-close .5493061443340548 (flatanh .5))
(test-assert (flnan? (flasin 2.)))

;; Integer division.
(test-equal 3. (flquotient 7. 2.))
(test-equal -3. (flquotient -7. 2.))
(test-equal 1. (flremainder 7. 2.))
(test-equal -1. (flremainder -7. 2.))
(test-equal '(-1. 4) (values->list (flremquo 7. 2.)))
(test-equal '(1. 4) (values->list (flremquo -7. -2.)))
(test-equal '(1. 2) (values->list (flremquo 7. 3.)))

;; Special functions.
(test-close 24. (flgamma 5.))
(test-close 1. (flgamma 1.))
(test-equal +inf.0 (flgamma 0.))
(test-assert (flnan? (flgamma -1.)))
(test-close 0. (car (values->list (flloggamma 1.))))
(test-equal 1. (cadr (values->list (flloggamma 3.))))
(test-close (fllog 2.) (car (values->list (flloggamma 3.))))
(test-equal -1. (cadr (values->list (flloggamma -.5))))
(test-close (fllog (fl* 2. (flsqrt fl-pi))) (car (values->list (flloggamma -.5))))
(test-equal 0. (flerf 0.))
(test-close .8427007929497149 (flerf 1.))
(test-equal 1. (flerfc 0.))
(test-close .15729920705028513 (flerfc 1.))
(test-close -.8427007929497149 (flerf -1.))
(test-close .7651976865579666 (flfirst-bessel 0 1.))
(test-close .44005058574493355 (flfirst-bessel 1 1.))
(test-close -.7812128213002887 (flsecond-bessel 1 1.))
(test-error (flfirst-bessel 1.5 1.))
(test-error (flsecond-bessel 1.5 1.))
(test-error (flsecond-bessel 1 1))
;; Huge orders answer at once or are refused; computing J_n for an order
;; like 2^100 by recurrence would not end.
(test-equal 0. (flfirst-bessel (expt 2 100) 1.))
(test-equal 0. (flfirst-bessel (- (expt 2 100)) -1.))
(test-assert (eqv? -0. (flfirst-bessel (+ (expt 2 100) 1) -1.)))
(test-equal -inf.0 (flsecond-bessel (expt 2 100) 1.))
(test-equal +inf.0 (flsecond-bessel (- (+ (expt 2 100) 1)) 1.))
(test-assert (flnan? (flsecond-bessel (expt 2 100) -1.)))
(test-assert (flnan? (flfirst-bessel (expt 2 100) +nan.0)))
(test-equal 0. (flfirst-bessel (expt 2 100) +inf.0))
(test-equal -inf.0 (flsecond-bessel (expt 2 100) 0.))
(test-equal 0. (flfirst-bessel 100000000 1.))
(test-error (flfirst-bessel (expt 2 100) 1e300))
(test-error (flsecond-bessel (expt 2 40) 1e300))

;; Signed zeros, infinities and NaNs, as C99 has them.
(test-assert (flnan? (flexp +nan.0)))
(test-equal +inf.0 (flexp +inf.0))
(test-equal 1. (flexp -0.))
(test-equal +inf.0 (flexp2 +inf.0))
(test-equal 0. (flexp2 -inf.0))
(test-equal 1. (flexp2 -0.))
(test-equal -1. (flexp-1 -inf.0))
(test-assert (eqv? -0. (flexp-1 -0.)))
(test-equal +inf.0 (flexp-1 +inf.0))
(test-equal +inf.0 (flsquare -inf.0))
(test-assert (eqv? 0. (flsquare -0.)))
(test-assert (flnan? (flsquare +nan.0)))
(test-assert (eqv? -0. (flcbrt -0.)))
(test-equal -inf.0 (flcbrt -inf.0))
(test-equal +inf.0 (flcbrt +inf.0))
(test-equal 1. (flexpt +nan.0 0.))
(test-equal 1. (flexpt 1. +nan.0))
(test-equal +inf.0 (flexpt 0. -1.))
(test-equal -inf.0 (flexpt -0. -1.))
(test-equal +inf.0 (flexpt 2. +inf.0))
(test-equal 0. (flexpt 2. -inf.0))
(test-assert (flnan? (flexpt -8. .3333333333333333)))
(test-assert (flnan? (flsin +inf.0)))
(test-assert (flnan? (flcos -inf.0)))
(test-assert (flnan? (fltan +inf.0)))
(test-assert (eqv? -0. (flsin -0.)))
(test-assert (eqv? -0. (fltan -0.)))
(test-equal +inf.0 (flquotient +inf.0 0.))
(test-assert (flnan? (flquotient +inf.0 +inf.0)))
(test-assert (flnan? (flquotient +nan.0 1.)))
(test-equal +inf.0 (flquotient 1. 0.))
(test-equal -inf.0 (flquotient -1. 0.))
(test-assert (flnan? (flquotient 0. 0.)))
(test-equal 0. (flquotient 1. +inf.0))
(test-assert (flnan? (flremainder +inf.0 2.)))
(test-assert (flnan? (flremainder 1. 0.)))
(test-assert (flnan? (flremainder +nan.0 2.)))
(test-equal 3. (flremainder 3. +inf.0))
(test-assert (eqv? -0. (flremainder -4. 2.)))
(test-equal +inf.0 (flatanh 1.))
(test-equal -inf.0 (flatanh -1.))
(test-assert (flnan? (flatanh 1.5)))
(test-assert (eqv? -0. (flatanh -0.)))
(test-equal 1. (flerf +inf.0))
(test-equal -1. (flerf -inf.0))
(test-equal 0. (flerfc +inf.0))
(test-equal 2. (flerfc -inf.0))
(test-assert (flnan? (flerf +nan.0)))
(test-assert (eqv? -0. (flerf -0.)))

;; Arguments must be flonums.
(test-error (fl+ 1 2.))
(test-error (fl+ 1. 'a))
(test-error (flsqrt 4))
(test-error (flexp 0))
(test-error (fl<? 1. 2))
(test-error (flmax 1. 2))
(test-error (fl- 1))
(test-error (flzero? 0))
(test-error (flatan 1 1.))
(test-error (flquotient 7 2.))

(test-end)
