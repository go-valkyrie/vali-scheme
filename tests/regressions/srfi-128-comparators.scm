;;; requirement: (srfi 128) comparators and the hash functions under them
;;; found-in: SRFI audit
;;; kind: scheme

;; Every constructor, the default comparator's order across types, the
;; standard hash functions, and the rule that equal objects hash alike
;; (`2` and `2.0` included, which `=` and the default comparator equate).

(import (scheme base) (scheme char) (scheme complex) (srfi 64) (srfi 128))

(test-begin "srfi-128")
(test-assert (memq 'srfi-128 (features)))

;; Predicates and accessors.
(define c (make-comparator integer? = < (lambda (n) (modulo n 7))))
(test-assert (comparator? c))
(test-assert (not (comparator? 1)))
(test-assert (comparator-ordered? c))
(test-assert (comparator-hashable? c))
(test-assert (comparator-test-type c 3))
(test-assert (not (comparator-test-type c 'a)))
(test-assert (comparator-check-type c 3))
(test-error (comparator-check-type c 'a))
(test-eqv 3 (comparator-hash c 10))
(test-eq = (comparator-equality-predicate c))
(test-eq < (comparator-ordering-predicate c))
(test-assert ((comparator-type-test-predicate c) 1))
(test-eqv 2 ((comparator-hash-function c) 9))

;; Missing parts raise when used and are reported by the flags.
(define bare (make-comparator #t eqv? #f #f))
(test-assert (not (comparator-ordered? bare)))
(test-assert (not (comparator-hashable? bare)))
(test-assert (comparator-test-type bare 'anything))
(test-error (<? bare 1 2))
(test-error (comparator-hash bare 1))
(test-assert (=? bare 1 1))

;; An equality of #t is derived from the ordering.
(define derived (make-comparator real? #t < #f))
(test-assert (=? derived 2 2))
(test-assert (not (=? derived 2 3)))

;; The comparison predicates chain.
(test-assert (<? c 1 2 3))
(test-assert (not (<? c 1 3 2)))
(test-assert (<=? c 1 1 2))
(test-assert (not (<=? c 2 1)))
(test-assert (>? c 3 2 1))
(test-assert (>=? c 3 3 1))
(test-assert (not (>=? c 1 3)))
(test-assert (=? c 2 2 2))
(test-assert (not (=? c 2 2 3)))

;; comparator-if<=>, with and without a comparator.
(test-eq 'less (comparator-if<=> c 1 2 'less 'equal 'greater))
(test-eq 'equal (comparator-if<=> c 2 2 'less 'equal 'greater))
(test-eq 'greater (comparator-if<=> c 3 2 'less 'equal 'greater))
(test-eq 'less (comparator-if<=> "a" "b" 'less 'equal 'greater))
(test-eq 'greater (comparator-if<=> 'b 'a 'less 'equal 'greater))

;; hash-bound and hash-salt.
(test-assert (and (exact-integer? (hash-bound)) (> (hash-bound) 0)))
(test-assert (and (exact-integer? (hash-salt)) (>= (hash-salt) 0)
                  (< (hash-salt) (hash-bound))))

;; The standard hash functions: each is in range and agrees with its
;; equivalence.
(define (in-range? h) (and (exact-integer? h) (>= h 0) (< h (hash-bound))))
(test-assert (in-range? (boolean-hash #t)))
(test-assert (in-range? (char-hash #\a)))
(test-assert (in-range? (string-hash "abc")))
(test-assert (in-range? (symbol-hash 'abc)))
(test-assert (in-range? (number-hash 1/3)))
(test-eqv (boolean-hash #f) (boolean-hash #f))
(test-assert (not (= (boolean-hash #t) (boolean-hash #f))))
(test-eqv (char-hash #\a) (char-hash #\a))
(test-eqv (char-ci-hash #\a) (char-ci-hash #\A))
(test-eqv (string-hash "abc") (string-hash (string #\a #\b #\c)))
(test-eqv (string-ci-hash "Straße") (string-ci-hash "STRASSE"))
(test-eqv (string-ci-hash "abc") (string-ci-hash "ABC"))
(test-assert (not (= (string-hash "abc") (string-hash "abd"))))
(test-eqv (symbol-hash 'abc) (symbol-hash (string->symbol "abc")))
(test-assert (not (= (symbol-hash 'abc) (symbol-hash 'abd))))
(test-eqv (number-hash 2) (number-hash 2.0))
(test-eqv (number-hash 1/2) (number-hash 0.5))
(test-eqv (number-hash 0) (number-hash -0.0))
(test-eqv (number-hash (expt 2 100)) (number-hash (inexact (expt 2 100))))
(test-eqv (number-hash (make-rectangular 1 2))
          (number-hash (make-rectangular 1.0 2.0)))
(test-eqv (number-hash 3) (number-hash (make-rectangular 3.0 0.0)))
(test-assert (not (= (number-hash 1) (number-hash 2))))
(test-assert (not (= (number-hash 1/2) (number-hash 1/3))))
(test-assert (not (= (number-hash (expt 2 100)) (number-hash (+ 1 (expt 2 100))))))
(test-eqv (number-hash +nan.0) (number-hash +nan.0))
(test-eqv (number-hash +inf.0) (number-hash +inf.0))
(test-assert (not (= (number-hash +inf.0) (number-hash -inf.0))))
;; An optional bound, as SRFI 69's hash functions take.
(test-assert (< (string-hash "abc" 10) 10))
(test-eqv (string-hash "abc" 10) (modulo (string-hash "abc") 10))
(test-error (string-hash 'abc))
(test-error (number-hash 'abc))
(test-error (symbol-hash "abc"))

;; default-hash matches the type's hash function, and is consistent with the
;; default comparator's equality.
(test-eqv (string-hash "abc") (default-hash "abc"))
(test-eqv (symbol-hash 'abc) (default-hash 'abc))
(test-eqv (number-hash 2) (default-hash 2))
(test-eqv (default-hash 2) (default-hash 2.0))
(test-eqv (default-hash '(1 2 (3))) (default-hash (list 1 2 (list 3))))
(test-eqv (default-hash '(1 2.0 (3))) (default-hash '(1.0 2 (3))))
(test-eqv (default-hash #(a "b" 3)) (default-hash (vector 'a (string #\b) 3)))
(test-eqv (default-hash (bytevector 1 2 3)) (default-hash (bytevector 1 2 3)))
(test-assert (not (= (default-hash '(1 2)) (default-hash '(2 1)))))
(test-assert (not (= (default-hash '(1 2)) (default-hash #(1 2)))))
(test-assert (in-range? (default-hash (list 1 "a" #\b 'c 4.5 #(1)))))

;; make-eq-comparator, make-eqv-comparator, make-equal-comparator.
(define eq-c (make-eq-comparator))
(define eqv-c (make-eqv-comparator))
(define equal-c (make-equal-comparator))
(define a-list (list 1 2))
(test-assert (comparator-test-type eq-c 'anything))
(test-assert (=? eq-c a-list a-list))
(test-assert (not (=? eq-c a-list (list 1 2))))
(test-assert (=? eqv-c 2.5 2.5))
(test-assert (not (=? eqv-c 2 2.0)))
(test-assert (=? equal-c (list 1 2) (list 1 2)))
(test-assert (not (=? equal-c (list 1 2) (list 1 3))))
(test-eqv (comparator-hash eq-c a-list) (comparator-hash eq-c a-list))
(test-eqv (comparator-hash eqv-c 2.5) (comparator-hash eqv-c 2.5))
(test-eqv (comparator-hash eqv-c (expt 10 30)) (comparator-hash eqv-c (expt 10 30)))
(test-eqv (comparator-hash equal-c (list "a" 2)) (comparator-hash equal-c (list "a" 2)))
(test-assert (comparator-hashable? eq-c))
(test-assert (comparator-hashable? equal-c))
;; Their hashes are in range for any object.
(test-assert (in-range? (comparator-hash eq-c (lambda (x) x))))
(test-assert (in-range? (comparator-hash eq-c (current-output-port))))
(test-assert (in-range? (comparator-hash eqv-c (make-string 3 #\x))))

;; The default comparator.
(define d (make-default-comparator))
(test-assert (comparator-ordered? d))
(test-assert (comparator-hashable? d))
(test-assert (comparator-test-type d 'anything))
(test-assert (<? d '() (cons 1 2) #f #t #\a "a" 'a 1 #(1) (bytevector 1)))
(test-assert (not (<? d "a" #\a)))
(test-assert (<? d #f #t))
(test-assert (not (<? d #t #f)))
(test-assert (<? d #\a #\b))
(test-assert (<? d "abc" "abd"))
(test-assert (<? d "ab" "abc"))
(test-assert (<? d 'a 'b))
(test-assert (<? d 1 2.5 3))
(test-assert (=? d 2 2.0))
(test-assert (<? d 1 (make-rectangular 1 1)))
(test-assert (<? d (make-rectangular 1 1) (make-rectangular 2 0)))
(test-assert (=? d (make-rectangular 1 2) (make-rectangular 1.0 2.0)))
(test-assert (<? d '(1 2) '(1 3)))
(test-assert (<? d '(1) '(1 0)))
(test-assert (<? d '(1 . 2) '(1 . 3)))
(test-assert (=? d '(1 (2 "x") #(3)) (list 1 (list 2 "x") (vector 3))))
(test-assert (<? d #(1 2) #(1 3)))
(test-assert (<? d #(9) #(1 2)))
(test-assert (<? d (bytevector 1 2) (bytevector 1 3)))
(test-assert (<? d (bytevector 9) (bytevector 1 1)))
(test-assert (=? d (bytevector 1 2) (bytevector 1 2)))
(test-assert (=? d 'a 'a))
(test-assert (not (=? d 'a 'b)))
(test-assert (not (=? d "a" 'a)))
(test-assert (not (=? d '() #f)))
(test-error (<? d (lambda (x) x) (lambda (x) x)))

;; Sorting under the default comparator, across types.
(define (sorted xs)
  (let loop ((xs xs) (acc '()))
    (if (null? xs)
        acc
        (loop (cdr xs)
              (let insert ((acc acc))
                (cond ((null? acc) (list (car xs)))
                      ((<? d (car xs) (car acc)) (cons (car xs) acc))
                      (else (cons (car acc) (insert (cdr acc))))))))))
(test-equal '(() (1 . 2) #f #t #\a "a" b 1 2 #(1) #u8(1))
            (sorted (list 2 #u8(1) 'b "a" #t 1 #\a '() #(1) #f '(1 . 2))))

;; make-pair-comparator.
(define pc (make-pair-comparator (make-default-comparator)
                                 (make-default-comparator)))
(test-assert (comparator-test-type pc '(1 . 2)))
(test-assert (not (comparator-test-type pc 1)))
(test-assert (=? pc '(1 . 2) (cons 1 2)))
(test-assert (<? pc '(1 . 2) '(1 . 3)))
(test-assert (<? pc '(1 . 9) '(2 . 0)))
(test-assert (not (<? pc '(2 . 0) '(1 . 9))))
(test-eqv (comparator-hash pc '(1 . 2)) (comparator-hash pc (cons 1 2)))
(define strict-pc (make-pair-comparator
                   (make-comparator string? string=? string<? string-hash)
                   (make-comparator integer? = < number-hash)))
(test-assert (comparator-test-type strict-pc '("a" . 1)))
(test-assert (not (comparator-test-type strict-pc '(a . 1))))
(test-assert (not (comparator-test-type strict-pc '("a" . b))))

;; make-list-comparator, over lists and over strings seen as lists.
(define lc (make-list-comparator (make-default-comparator) list? null? car cdr))
(test-assert (comparator-test-type lc '(1 2)))
(test-assert (not (comparator-test-type lc 1)))
(test-assert (=? lc '() '()))
(test-assert (=? lc '(1 2) (list 1 2)))
(test-assert (not (=? lc '(1 2) '(1 2 3))))
(test-assert (<? lc '() '(1)))
(test-assert (not (<? lc '(1) '())))
(test-assert (<? lc '(1 2) '(1 3)))
(test-assert (<? lc '(1 2) '(1 2 0)))
(test-assert (not (<? lc '(1 2 0) '(1 2))))
(test-eqv (comparator-hash lc '(1 2 3)) (comparator-hash lc (list 1 2 3)))
(test-assert (not (= (comparator-hash lc '(1 2 3)) (comparator-hash lc '(3 2 1)))))
(test-eqv (comparator-hash lc '()) (comparator-hash lc '()))
;; A long list hashes without looking at all of it.
(test-assert (in-range? (comparator-hash lc (make-list 100000 1))))

;; make-vector-comparator, over vectors and bytevectors.
(define vc (make-vector-comparator (make-default-comparator) vector?
                                   vector-length vector-ref))
(test-assert (=? vc #() #()))
(test-assert (=? vc #(1 2) (vector 1 2)))
(test-assert (not (=? vc #(1 2) #(1 2 3))))
(test-assert (<? vc #(5) #(1 2)))
(test-assert (<? vc #(1 2) #(1 3)))
(test-assert (not (<? vc #(1 3) #(1 2))))
(test-eqv (comparator-hash vc #(1 2 3)) (comparator-hash vc (vector 1 2 3)))
(test-assert (in-range? (comparator-hash vc (make-vector 100000 1))))
(define bc (make-vector-comparator (make-default-comparator) bytevector?
                                   bytevector-length bytevector-u8-ref))
(test-assert (=? bc (bytevector 1 2) (bytevector 1 2)))
(test-assert (<? bc (bytevector 1 2) (bytevector 1 3)))
(test-eqv (comparator-hash bc (bytevector 1 2)) (comparator-hash bc (bytevector 1 2)))

;; Registering a type with the default comparator.
(define-record-type <point> (make-point x y) point? (x px) (y py))
(define point-comparator
  (make-comparator point?
                   (lambda (a b) (and (= (px a) (px b)) (= (py a) (py b))))
                   (lambda (a b) (or (< (px a) (px b))
                                     (and (= (px a) (px b)) (< (py a) (py b)))))
                   (lambda (p) (+ (* 31 (number-hash (px p))) (number-hash (py p))))))
(test-error (<? d (make-point 1 2) (make-point 1 3)))
(comparator-register-default! point-comparator)
(test-assert (=? d (make-point 1 2) (make-point 1 2)))
(test-assert (<? d (make-point 1 2) (make-point 1 3)))
(test-assert (<? d 'a (make-point 1 2)))
(test-assert (<? d (bytevector 1) (make-point 1 2)))
(test-assert (not (=? d (make-point 1 2) (make-point 2 2))))
(test-eqv (default-hash (make-point 1 2)) (default-hash (make-point 1 2)))
(test-assert (=? d (list (make-point 1 2)) (list (make-point 1 2))))
(test-eqv (default-hash (list (make-point 1 2) "x"))
          (default-hash (list (make-point 1 2) "x")))
(test-eqv (default-hash (vector (make-point 1 2)))
          (default-hash (vector (make-point 1 2))))
(test-eqv (default-hash 2) (default-hash 2.0))
(test-eqv (default-hash '(1 "a")) (default-hash '(1.0 "a")))

(test-end)
